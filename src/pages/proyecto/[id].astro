---
import Base from '../../layouts/Base.astro'
import Fuente from '../../components/Fuente.astro'
import PotenciaProyecto from '../../components/PotenciaProyecto.astro'
import { MODALIDAD_COMPUTO_ETIQUETA, MODALIDAD_COMPUTO_DESCRIPCION } from '../../lib/computo.js'
import { alcanceComputo, avisoComputo, modeloComputo } from '../../lib/computo-presentacion.js'
import CronologiaProyecto from '../../components/CronologiaProyecto.astro'
import { etiquetaFechaServicio, presentacionProyecto, vinculosEnergiaProyecto } from '../../lib/proyecto-presentacion.js'
import sitios from '../../data/sitios.json'
import renovables from '../../data/renovables.json'
import normativa from '../../data/normativa.json'
import {
  ESTADO_ETIQUETA,
  POTENCIA_ETIQUETA,
  PRECISION_ETIQUETA,
  CONFIANZA_ETIQUETA,
  CONFIANZA_DESCRIPCION,
  motivosConfianza,
  MODELO_ETIQUETA,
  CIRCUITO_ETIQUETA,
  CIRCUITO_DESCRIPCION,
  EMPLEO_ETIQUETA,
  COMPUTO_ETIQUETA,
  unidadesComputo,
  rendimientoComputo,
  energia as energiaLegible,
  volumen,
  campoLegible,
  fechaLegible,
  numero,
  euros,
  superficie,
  slug,
} from '../../lib/etiquetas.js'
import {
  GLOSARIO_POTENCIA,
  GLOSARIO_CIRCUITO,
  GLOSARIO_COMPUTO,
  GLOSARIO_MODELO,
} from '../../lib/glosario.js'
import Termino from '../../components/Termino.astro'
import {
  ESTADO_NORMA_ETIQUETA,
  ordenarNormas,
  normasQueAfectanA,
} from '../../lib/normativa.js'

export function getStaticPaths() {
  return sitios.map((s) => ({ params: { id: s.id }, props: { sitio: s } }))
}

const { sitio: s } = Astro.props
const presentacion = presentacionProyecto(s)
const computoVisible = s.computo.map((c) => ({ ...c, proyecto: s.id }))

// Normas que nombran este emplazamiento, y las que alcanzan a su comunidad. El
// vínculo lo declara la propia norma en `afecta[]`: no se deduce aquí.
const normasDelProyecto = normasQueAfectanA(normativa, 'proyecto', s.id)
const normasDeLaRegion = s.ubicacion.ccaa
  ? normasQueAfectanA(normativa, 'region', s.ubicacion.ccaa).filter(
      (x) => !normasDelProyecto.some((y) => y.norma.id === x.norma.id),
    )
  : []
const normasAplicables = ordenarNormas(
  [...normasDelProyecto, ...normasDeLaRegion].map((x) => x.norma),
).map((norma) => ({
  norma,
  vinculos: [...normasDelProyecto, ...normasDeLaRegion].find((x) => x.norma.id === norma.id).vinculos,
  directa: normasDelProyecto.some((x) => x.norma.id === norma.id),
}))

// Índice de fuentes: cada dato del cuerpo apunta a su número de referencia.
const indice = new Map(s.fuentes.map((f, i) => [f.id, i + 1]))
const refs = (ids) =>
  (ids ?? [])
    .map((id) => indice.get(id))
    .filter(Boolean)
    .sort((a, b) => a - b)

// Lo que debilita el respaldo de esta ficha en concreto, leído de la propia ficha.
const motivos = motivosConfianza(s)


const { emplazamiento: vinculados, operador: ppaDelOperador } = vinculosEnergiaProyecto(s, renovables)

const mapaEstatico = s.ubicacion.lat != null
const ubicacionTexto = [s.ubicacion.municipio, s.ubicacion.provincia, s.ubicacion.ccaa]
  .filter(Boolean)
  .filter((v, i, a) => a.indexOf(v) === i)
  .join(', ')
---

<Base
  titulo={s.nombre}
  descripcion={`${s.nombre}: ${ESTADO_ETIQUETA[s.estado]}${ubicacionTexto ? ` en ${ubicacionTexto}` : ''}. Ficha documental con fuentes.`}
>
  <div class="contenedor">
    <p class="migas">
      <a href="/proyectos">Proyectos</a>
      {s.operador && <> · <a href={`/compania/${slug(s.operador)}`}>{s.operador}</a></>}
      {s.ubicacion.ccaa && <> · <a href={`/region/${slug(s.ubicacion.ccaa)}`}>{s.ubicacion.ccaa}</a></>}
    </p>

    <header class="ficha-cabecera">
      <div class="estado-cabecera">
        <span class={`etiqueta estado-${s.estado}`}><span class="punto"></span>{ESTADO_ETIQUETA[s.estado]}</span>
        <span class={`etiqueta confianza-${s.confianza}`} title={CONFIANZA_DESCRIPCION[s.confianza]}>
          <Termino id="confianza">{CONFIANZA_ETIQUETA[s.confianza]}</Termino>
        </span>
      </div>
      <h1>{presentacion.titulo}</h1>
      <p class="identidad-breve">
        {ubicacionTexto && <span>{ubicacionTexto}</span>}
        <span>{s.operador ? <a href={`/compania/${slug(s.operador)}`}>{s.operador}</a> : 'Operador sin determinar'}</span>
        <span>Verificado el <time datetime={s.ultima_verificacion}>{fechaLegible(s.ultima_verificacion)}</time></span>
      </p>
      {presentacion.resumen && (
        <p class="resumen-breve">
          {presentacion.resumen}
          <sup>{refs(presentacion.fuentes).map((n, i) => <>{i > 0 && ','}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</sup>
        </p>
      )}
      <nav class="saltos-ficha" aria-label="En esta ficha">
        <a href="#datos-clave">Datos clave</a>
        {presentacion.cronologia.length > 0 && <a href="#cronologia">Cronología</a>}
        {s.incertidumbres.length > 0 && <a href="#incertidumbres">{s.incertidumbres.length} incertidumbres</a>}
        <a href="#fuentes">{s.fuentes.length} fuentes</a>
        {mapaEstatico && <a href={`/?q=${encodeURIComponent(s.nombre)}`}>Ver en el mapa</a>}
      </nav>
    </header>

    <section class="datos-clave" aria-labelledby="datos-clave" id="potencia">
      <h2 id="datos-clave">Datos clave</h2>
      <PotenciaProyecto sitio={s} />
      {(presentacion.hardware || s.computo.length > 0) && (
        <div class="hardware-breve">
          <h3>Hardware documentado</h3>
          <dl>
            {presentacion.hardware ? presentacion.hardware.map((h) => (
              <div>
                <dt>{h.modelo}</dt>
                <dd>
                  <strong>{h.dato}</strong>
                  <span class="matiz-dato">{h.matiz}</span>
                  <sup>{refs(h.fuentes).map((n, i) => <>{i > 0 && ','}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</sup>
                </dd>
              </div>
            )) : computoVisible.slice(0, 4).map((c) => (
              <div>
                <dt>{modeloComputo(c)}{alcanceComputo(c) && <span class="procedencia-dato">{alcanceComputo(c)}</span>}</dt>
                <dd>
                  <strong>{unidadesComputo(c.unidades, c.tipo_unidad) ?? (c.nodos != null ? `${numero(c.nodos)} nodos; unidades sin publicar` : 'Recuento sin publicar')}</strong>
                  {c.estado !== 'desconocido' && <span class={`etiqueta estado-${c.estado}`}>{ESTADO_ETIQUETA[c.estado]}</span>}
                  <span class="procedencia-dato" title={MODALIDAD_COMPUTO_DESCRIPCION[c.modalidad ?? 'sin_confirmar']}>{MODALIDAD_COMPUTO_ETIQUETA[c.modalidad ?? 'sin_confirmar']}</span>
                  {rendimientoComputo(c) && <span class="procedencia-dato">{rendimientoComputo(c)}</span>}
                  {avisoComputo(c) && <a class="matiz-dato" href="#incertidumbres">{avisoComputo(c)}</a>}
                </dd>
              </div>
            ))}
          </dl>
          <p class="pequeno"><a href="#detalle-computo">Inventario y fuentes{s.computo.length > 4 ? ` · ${s.computo.length} registros` : ''}</a></p>
        </div>
      )}
      {presentacion.aviso && (
        <p class="aviso-breve">
          {presentacion.aviso}
          <sup>{refs(presentacion.avisoFuentes).map((n, i) => <>{i > 0 && ','}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</sup>
        </p>
      )}
    </section>

    <div class="dos-columnas">
      <div>
        {s.estado_detalle && (
          <details class="seccion-plegable" id="estado-detalle">
            <summary>Estado y antecedentes</summary>
            <div class="contenido-plegable">
              <p>{s.estado_detalle}<sup>{refs(s.estado_fuentes).map((n, i) => <>{i > 0 && ','}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</sup></p>
            </div>
          </details>
        )}
        <CronologiaProyecto eventos={presentacion.cronologia} fuentes={s.fuentes} />
        {s.potencia.length > 0 && (
          <details class="seccion-plegable" id="detalle-potencia">
            <summary>Lecturas de potencia <span>{s.potencia.length} {s.potencia.length === 1 ? 'registro' : 'registros'}</span></summary>
            <div class="contenido-plegable">
          {s.potencia.length === 0 ? (
            <p class="silencio">Ninguna fuente publica cifras de potencia.</p>
          ) : (
            <>
              <div class="tabla-envoltorio">
                <table class="tabla-fichas">
                  <thead>
                    <tr>
                      <th>Tipo</th>
                      <th class="num">MW</th>
                      <th>Ámbito</th>
                      <th>Estado del dato</th>
                      <th>Referencia</th>
                      <th>Fecha del dato</th>
                      <th>Fuente</th>
                    </tr>
                  </thead>
                  <tbody>
                    {s.potencia.map((p) => (
                      <tr>
                        <td><Termino id={GLOSARIO_POTENCIA[p.tipo]}>{POTENCIA_ETIQUETA[p.tipo]}</Termino></td>
                        <td class="num" data-etiqueta="MW">
                          {numero(p.valor_mw, 3) ?? (p.valor_mva ? `${numero(p.valor_mva, 3)} MVA` : '—')}
                          {p.valor_mw_max && `–${numero(p.valor_mw_max, 3)}`}
                        </td>
                        <td data-etiqueta="Ámbito">{p.ambito}</td>
                        <td data-etiqueta="Estado del dato">{p.estado_asociado ? ESTADO_ETIQUETA[p.estado_asociado] : 'Sin estado asociado'}</td>
                        <td data-etiqueta="Referencia">
                          {p.edificio && <><strong class="unidad">{p.edificio}</strong><br /></>}
                          {p.referencia ?? <span class="silencio">—</span>}
                          {p.nota && <span class="pequeno silencio"><br />{p.nota}</span>}
                        </td>
                        <td data-etiqueta="Fecha del dato">{fechaLegible(p.fecha_dato) ?? <span class="silencio">sin fechar</span>}</td>
                        <td class="num" data-etiqueta="Fuente">
                          {refs(p.fuentes).map((n, i) => (
                            <>{i > 0 && ', '}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>
                          ))}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {s.potencia.some((p) => p.tipo === 'no_especificado') && (
                <p class="nota pequeno">
                  <strong>Cifras sin tipificar.</strong> Alguna fuente da MW sin aclarar si son carga
                  TI, potencia de conexión o potencia instalada. Se muestran aparte y no se suman con
                  las demás.
                </p>
              )}
            </>
          )}

            </div>
          </details>
        )}

        {s.fases.length > 0 && (
          <details class="seccion-plegable" id="fases">
            <summary>Fases <span>{s.fases.length}</span></summary>
            <div class="contenido-plegable">
            <div class="tabla-envoltorio">
              <table class="tabla-fichas">
                <thead>
                  <tr>
                    <th>Fase</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th class="num">Superficie</th>
                    <th>Fuente</th>
                  </tr>
                </thead>
                <tbody>
                  {s.fases.map((f) => (
                    <tr>
                      <td>
                        {f.nombre}
                        {f.nota && <span class="pequeno silencio"><br />{f.nota}</span>}
                      </td>
                      <td data-etiqueta="Estado">
                        {f.estado ? (
                          <span class={`etiqueta estado-${f.estado}`}><span class="punto"></span>{ESTADO_ETIQUETA[f.estado]}</span>
                        ) : (
                          <span class="silencio">—</span>
                        )}
                      </td>
                      <td data-etiqueta="Fecha" data-vacia={f.fecha_puesta_en_servicio ? 'no' : 'si'}>
                        {fechaLegible(f.fecha_puesta_en_servicio) ?? '—'}
                        {f.fecha_puesta_en_servicio && etiquetaFechaServicio(f, undefined, s.id) !== 'Puesta en servicio' && <span class="pequeno silencio"><br />{etiquetaFechaServicio(f, undefined, s.id) === 'Puesta en servicio prevista' ? 'Servicio previsto' : etiquetaFechaServicio(f, undefined, s.id)}</span>}
                      </td>
                      <td class="num" data-etiqueta="Superficie" data-vacia={f.superficie_m2 ? 'no' : 'si'}>{superficie(f.superficie_m2) ?? '—'}</td>
                      <td class="num" data-etiqueta="Fuente">
                        {refs(f.fuentes).map((n, i) => (
                          <>{i > 0 && ', '}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>
                        ))}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            </div>
          </details>
        )}

        {s.incertidumbres.length > 0 && (
          <details class="seccion-plegable" id="incertidumbres">
            <summary>Incertidumbres y contradicciones <span>{s.incertidumbres.length}</span></summary>
            <div class="contenido-plegable">
            <ul class="incertidumbres">
              {s.incertidumbres.map((u) => (
                <li>
                  <strong>{campoLegible(u.campo)}</strong>
                  <span>
                    {u.descripcion}
                    {refs(u.fuentes).length > 0 && (
                      <sup>{refs(u.fuentes).map((n, i) => <>{i > 0 && ','}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</sup>
                    )}
                  </span>
                </li>
              ))}
            </ul>
            </div>
          </details>
        )}

        {vinculados.length > 0 && (
          <details class="seccion-plegable" id="generacion-vinculada">
            <summary>Generación y almacenamiento vinculados <span>{vinculados.length}</span></summary>
            <div class="contenido-plegable">
            {vinculados.some((a) => a.tipo_vinculo === 'ppa') && <p class="pequeno silencio">Los PPA no acreditan suministro físico directo.</p>}
            <div class="tabla-envoltorio">
              <table class="tabla-fichas">
                <thead>
                  <tr><th>Activo</th><th>Tipo</th><th class="num">MW</th><th>Vínculo</th><th>Estado</th></tr>
                </thead>
                <tbody>
                  {vinculados.map((a) => (
                    <tr>
                      <td>{a.nombre}</td>
                      <td data-etiqueta="Tipo">{a.tipo}</td>
                      <td class="num" data-etiqueta="Potencia">{numero(a.potencia_mw, 1) ?? '—'}</td>
                      <td data-etiqueta="Vínculo">{a.tipo_vinculo}</td>
                      <td data-etiqueta="Estado">{a.estado}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            </div>
          </details>
        )}

        {ppaDelOperador.length > 0 && (
          <details class="seccion-plegable" id="ppa-operador">
            <summary>PPA del operador sin asignación a este centro <span>{ppaDelOperador.length}</span></summary>
            <div class="contenido-plegable">
              <p class="pequeno silencio">Contratos de {s.operador}. Las fuentes no los asignan a este emplazamiento ni acreditan suministro físico directo.</p>
              <ul class="ppa-operador">
                {ppaDelOperador.map((a) => <li><strong>{a.nombre}</strong><span>{a.tipo_vinculo} · {a.estado}</span>{a.potencia_mw != null && <span>{numero(a.potencia_mw, 1)} MW del contrato o activo; sin reparto publicado por centro</span>}</li>)}
              </ul>
              <p class="pequeno"><a href="/renovables">Ver fuentes y datos de energía</a></p>
            </div>
          </details>
        )}

        {normasAplicables.length > 0 && (
          <details class="seccion-plegable" id="normativa">
            <summary>Normativa que le afecta <span>{normasAplicables.length}</span></summary>
            <div class="contenido-plegable">
            <ul class="normas-afectan">
              {normasAplicables.map(({ norma, vinculos, directa }) => (
                <li>
                  <p class="cabecera-norma">
                    <a href={`/normativa/${norma.id}`}>{norma.titulo}</a>
                    <span class={`etiqueta estado-norma-${norma.estado}`}>
                      <span class="punto" aria-hidden="true"></span>{ESTADO_NORMA_ETIQUETA[norma.estado]}
                    </span>
                    {!directa && <span class="pequeno silencio">alcance regional</span>}
                  </p>
                  {vinculos.map((v) => <p class="pequeno">{v.como}</p>)}
                </li>
              ))}
            </ul>
            </div>
          </details>
        )}

        <details class="seccion-plegable" id="fuentes">
          <summary>Fuentes <span>{s.fuentes.length}</span></summary>
          <div class="contenido-plegable">
            <ol class="fuentes">
              {s.fuentes.map((f, i) => <Fuente fuente={f} numero={i + 1} />)}
            </ol>
          </div>
        </details>
      </div>

      <aside class="lateral" aria-label="Detalles del proyecto">
        <details class="seccion-plegable">
          <summary>Identificación y ubicación</summary>
          <div class="contenido-plegable">
        <div class="tarjeta">
          <h3 class="titulo-lateral">Identificación</h3>
          <p class="pequeno">{s.nombre}</p>
          {s.alias.length > 0 && <p class="pequeno silencio">También citado como: {s.alias.join(' · ')}</p>}
          <dl class="pares">
            <dt>Operador</dt>
            <dd>{s.operador ? <a href={`/compania/${slug(s.operador)}`}>{s.operador}</a> : <span class="silencio">sin determinar</span>}</dd>
            {s.propietario && s.propietario !== s.operador && (<><dt>Propietario</dt><dd>{s.propietario}</dd></>)}
            {s.cliente_ancla && (<><dt>Cliente ancla</dt><dd>{s.cliente_ancla}</dd></>)}
            <dt>Modelo</dt>
            <dd>
              {GLOSARIO_MODELO[s.modelo]
                ? <Termino id={GLOSARIO_MODELO[s.modelo]}>{MODELO_ETIQUETA[s.modelo]}</Termino>
                : MODELO_ETIQUETA[s.modelo]}
            </dd>
            <dt>Tipo de registro</dt>
            <dd>{s.tipo === 'campus' ? 'Campus (varios edificios)' : 'Edificio'}</dd>
          </dl>
        </div>

        <div class="tarjeta">
          <h3 class="titulo-lateral">Ubicación</h3>
          <dl class="pares">
            {s.ubicacion.direccion && (<><dt>Dirección</dt><dd>{s.ubicacion.direccion}</dd></>)}
            <dt>Municipio</dt>
            <dd>{s.ubicacion.municipio ?? <span class="silencio">sin determinar</span>}</dd>
            <dt>Provincia</dt>
            <dd>{s.ubicacion.provincia ?? <span class="silencio">—</span>}</dd>
            <dt>Comunidad</dt>
            <dd>{s.ubicacion.ccaa ? <a href={`/region/${slug(s.ubicacion.ccaa)}`}>{s.ubicacion.ccaa}</a> : '—'}</dd>
            <dt>Coordenadas</dt>
            <dd>
              {mapaEstatico ? (
                <>
                  <span class="mono">{s.ubicacion.lat.toFixed(5)}, {s.ubicacion.lon.toFixed(5)}</span>
                  <br />
                  <span class="pequeno silencio">{PRECISION_ETIQUETA[s.ubicacion.precision]}</span>
                  <br />
                  <a class="pequeno" href={`/?q=${encodeURIComponent(s.nombre)}`}>Ver en el mapa →</a>
                </>
              ) : (
                <span class="silencio">no publicadas</span>
              )}
            </dd>
          </dl>
        </div>

          </div>
        </details>

        {s.conexion_electrica && (
          <details class="seccion-plegable" id="conexion-electrica">
            <summary>Conexión eléctrica</summary>
            <div class="contenido-plegable">
            <dl class="pares">
              {s.conexion_electrica.subestacion && (<><dt><Termino id="subestacion">Subestación</Termino></dt><dd>{s.conexion_electrica.subestacion}</dd></>)}
              {s.conexion_electrica.tension_kv && (<><dt>Tensión</dt><dd>{numero(s.conexion_electrica.tension_kv)} <Termino id="kv">kV</Termino></dd></>)}
              {s.conexion_electrica.titular_red && (<><dt>Titular de red</dt><dd>{s.conexion_electrica.titular_red}</dd></>)}
              {s.conexion_electrica.mw_solicitados != null && (<><dt><Termino id="capacidad-en-curso">MW solicitados</Termino></dt><dd>{numero(s.conexion_electrica.mw_solicitados, 1)} MW</dd></>)}
              {s.conexion_electrica.mw_concedidos != null && (<><dt><Termino id="capacidad-otorgada">MW concedidos</Termino></dt><dd>{numero(s.conexion_electrica.mw_concedidos, 1)} MW</dd></>)}
            </dl>
            {s.conexion_electrica.nota && <p class="pequeno silencio">{s.conexion_electrica.nota}</p>}
            {refs(s.conexion_electrica.fuentes).length > 0 && <p class="pequeno">Fuentes: {refs(s.conexion_electrica.fuentes).map((n, i) => <>{i > 0 && ', '}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</p>}
            <p class="pequeno silencio">
              Una <Termino id="permiso-acceso">solicitud de acceso</Termino> no es un centro construido. Véase <a href="/red-electrica">red eléctrica</a>.
            </p>
            </div>
          </details>
        )}

        {(s.agua || s.refrigeracion) && (
          <details class="seccion-plegable" id="agua">
            <summary>Agua y refrigeración</summary>
            <div class="contenido-plegable">
            <dl class="pares">
              {s.agua?.circuito && (
                <>
                  <dt>Circuito</dt>
                  <dd>
                    {GLOSARIO_CIRCUITO[s.agua.circuito]
                      ? <Termino id={GLOSARIO_CIRCUITO[s.agua.circuito]}>{CIRCUITO_ETIQUETA[s.agua.circuito]}</Termino>
                      : (CIRCUITO_ETIQUETA[s.agua.circuito] ?? s.agua.circuito)}
                    <br />
                    <span class="pequeno silencio">{CIRCUITO_DESCRIPCION[s.agua.circuito]}</span>
                  </dd>
                </>
              )}
              {s.agua?.origen && (<><dt>Origen del agua</dt><dd>{s.agua.origen}</dd></>)}
              {s.agua?.consumo_m3_ano != null && (<><dt>Consumo anual</dt><dd>{volumen(s.agua.consumo_m3_ano)}</dd></>)}
              {s.agua?.consumo_m3_dia != null && (<><dt>Consumo diario</dt><dd>{volumen(s.agua.consumo_m3_dia)}</dd></>)}
              {s.agua?.wue_l_kwh != null && (<><dt><Termino id="wue">WUE</Termino></dt><dd>{numero(s.agua.wue_l_kwh, 2)} l/kWh</dd></>)}
              {s.agua?.sistema && (<><dt>Sistema</dt><dd>{s.agua.sistema}</dd></>)}
              {s.refrigeracion && (<><dt>Detalle</dt><dd>{s.refrigeracion}</dd></>)}
            </dl>
            {s.agua?.nota && <p class="pequeno silencio">{s.agua.nota}</p>}
            {refs(s.agua?.fuentes).length > 0 && (
              <p class="pequeno">
                Fuente:{' '}
                {refs(s.agua.fuentes).map((n, i) => (
                  <>{i > 0 && ', '}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>
                ))}
              </p>
            )}
            {s.agua?.consumo_m3_ano != null && s.agua?.consumo_m3_dia != null && (
              <p class="pequeno silencio">
                El consumo diario y el anual proceden de fuentes distintas y no se han convertido
                uno en otro: hacerlo exigiría suponer los días de operación a plena carga.
              </p>
            )}
            </div>
          </details>
        )}

        {s.energia.length > 0 && (
          <details class="seccion-plegable" id="energia">
            <summary>Consumo eléctrico</summary>
            <div class="contenido-plegable">
            <dl class="pares">
              {s.energia.map((e) => (
                <>
                  <dt>{e.referencia ?? 'Consumo anual'}</dt>
                  <dd>
                    {energiaLegible(e.consumo_gwh_ano)}
                    {e.nota && <span class="pequeno silencio"><br />{e.nota}</span>}
                    {refs(e.fuentes).length > 0 && (
                      <sup>{refs(e.fuentes).map((n, i) => <>{i > 0 && ','}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</sup>
                    )}
                  </dd>
                </>
              ))}
            </dl>
            <p class="pequeno silencio">
              <Termino id="gwh-ano">Energía consumida al año</Termino>, no potencia. No se compara
              ni se suma con las cifras de <Termino id="mw">MW</Termino>, que miden cosas distintas.
            </p>
            </div>
          </details>
        )}

        {(s.computo ?? []).length > 0 && (
          <details class="seccion-plegable" id="detalle-computo">
            <summary>Inventario de cómputo</summary>
            <div class="contenido-plegable">
            <dl class="pares">
              {computoVisible.map((c) => (
                <>
                  <dt>
                    {modeloComputo(c)}
                  </dt>
                  <dd>
                    {unidadesComputo(c.unidades, c.tipo_unidad) ?? 'Recuento no publicado'}
                    {c.estado && c.estado !== 'desconocido' && <span class={`etiqueta estado-${c.estado}`}>{ESTADO_ETIQUETA[c.estado]}</span>}
                    <span class="pequeno silencio" title={MODALIDAD_COMPUTO_DESCRIPCION[c.modalidad ?? 'sin_confirmar']}><br />{MODALIDAD_COMPUTO_ETIQUETA[c.modalidad ?? 'sin_confirmar']}</span>
                    {alcanceComputo(c) && <span class="pequeno silencio"><br />{alcanceComputo(c)}</span>}
                    <span class="pequeno silencio"><br />{GLOSARIO_COMPUTO[c.tipo] ? <Termino id={GLOSARIO_COMPUTO[c.tipo]}>{COMPUTO_ETIQUETA[c.tipo]}</Termino> : COMPUTO_ETIQUETA[c.tipo]}</span>
                    {c.nodos != null && (
                      <span class="pequeno silencio"><br />{numero(c.nodos)} {c.nodos === 1 ? 'nodo' : 'nodos'}</span>
                    )}
                    {c.fecha_dato && <span class="pequeno silencio"><br />Dato del {fechaLegible(c.fecha_dato)}</span>}
                    {rendimientoComputo(c) && <span class="pequeno"><br />{rendimientoComputo(c)}</span>}
                    {c.operador_computo && (
                      <span class="pequeno silencio"><br />Hardware operado por {c.operador_computo}</span>
                    )}
                    {c.nota && <span class="pequeno silencio"><br />{c.nota}</span>}
                    {refs(c.fuentes).length > 0 && (
                      <sup>{refs(c.fuentes).map((n, i) => <>{i > 0 && ','}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</sup>
                    )}
                  </dd>
                </>
              ))}
            </dl>
            <p class="pequeno silencio">
              Recursos documentados, con el estado de cada anuncio o instalación. No se convierten
              en MW eléctricos. Los <Termino id="flops">FLOPS</Termino> no se comparan entre{' '}
              <Termino id="precision-numerica">precisiones distintas</Termino> ni entre{' '}
              <Termino id="pico-vs-medido">pico y medida</Termino>.
            </p>
            </div>
          </details>
        )}

        {s.empleo.length > 0 && (
          <details class="seccion-plegable" id="empleo">
            <summary>Empleo anunciado</summary>
            <div class="contenido-plegable">
            <dl class="pares">
              {s.empleo.map((e) => (
                <>
                  <dt>{EMPLEO_ETIQUETA[e.tipo] ?? e.tipo}</dt>
                  <dd>
                    {numero(e.valor)} puestos
                    {e.referencia && <span class="pequeno silencio"><br />{e.referencia}</span>}
                    {e.nota && <span class="pequeno silencio"><br />{e.nota}</span>}
                    {refs(e.fuentes).length > 0 && (
                      <sup>{refs(e.fuentes).map((n, i) => <>{i > 0 && ','}<a href={`#fuente-${s.fuentes[n - 1].id}`}>{n}</a></>)}</sup>
                    )}
                  </dd>
                </>
              ))}
            </dl>
            <p class="pequeno silencio">
              Cifras anunciadas por el promotor o la administración, no contrastadas con ningún
              registro laboral. El empleo de obra es temporal y no se suma con el de explotación.
            </p>
            </div>
          </details>
        )}

        {(s.superficie_parcela_m2 || s.superficie_construida_m2 || s.inversion_anunciada_eur || s.fecha_puesta_en_servicio) && (
          <details class="seccion-plegable" id="otros-datos">
            <summary>Superficie, inversión y servicio</summary>
            <div class="contenido-plegable">
            <dl class="pares">
              {s.fecha_puesta_en_servicio && (<><dt>{etiquetaFechaServicio(s)}</dt><dd>{fechaLegible(s.fecha_puesta_en_servicio)}</dd></>)}
              {s.superficie_parcela_m2 && (<><dt>Parcela</dt><dd>{superficie(s.superficie_parcela_m2)}</dd></>)}
              {s.superficie_construida_m2 && (<><dt>Construido</dt><dd>{superficie(s.superficie_construida_m2)}</dd></>)}
              {s.inversion_anunciada_eur && (<><dt>Inversión anunciada</dt><dd>{euros(s.inversion_anunciada_eur)}<br /><span class="pequeno silencio">cifra anunciada públicamente, no verificada</span></dd></>)}
            </dl>
            </div>
          </details>
        )}

        <details class="seccion-plegable" id="trazabilidad">
          <summary>Trazabilidad y confianza</summary>
          <div class="contenido-plegable">
          <dl class="pares">
            <dt>Última verificación</dt>
            <dd>{fechaLegible(s.ultima_verificacion)}</dd>
            <dt>Fuentes</dt>
            <dd>{s.fuentes.length}</dd>
            <dt>Confianza</dt>
            <dd>
              <span class={`confianza-${s.confianza}`}><Termino id="confianza">{CONFIANZA_ETIQUETA[s.confianza]}</Termino></span>
              {motivos.length > 0 ? (
                <ul class="motivos-confianza">
                  {motivos.map((m) => <li>{m}</li>)}
                </ul>
              ) : (
                <><br /><span class="pequeno silencio">
                  {s.confianza === 'alta'
                    ? 'Ubicación, potencia y estado con respaldo primario y sin contradicciones abiertas.'
                    : s.incertidumbres.length > 0 && <a href="#incertidumbres">Ver incertidumbres</a>}
                </span></>
              )}
            </dd>
            <dt>Identificador</dt>
            <dd class="mono pequeno">{s.id}</dd>
          </dl>
          {s.enlaces_proyecto.length > 0 && (
            <p class="pequeno">
              {s.enlaces_proyecto.map((u) => <><a href={u} rel="noopener nofollow">Enlace del proyecto</a><br /></>)}
            </p>
          )}
          </div>
        </details>
      </aside>
    </div>
  </div>
</Base>

<style>
  .estado-cabecera { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .identidad-breve { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: 0.82rem; color: var(--tinta-2); margin: 0.6rem 0; }
  .identidad-breve time { white-space: nowrap; }
  .resumen-breve { max-width: 52rem; font-size: 0.96rem; line-height: 1.55; margin: 0.7rem 0; }
  .saltos-ficha { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.78rem; margin-top: 0.8rem; }
  .datos-clave { margin-bottom: 1.6rem; }
  .datos-clave h2 { margin: 0 0 0.6rem; font-family: var(--sans); font-size: 0.8rem; color: var(--tinta-3); }
  .sin-dato { font-size: 0.9rem; color: var(--tinta-2); margin: 0 0 0.8rem; }
  .potencias-breves { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); margin: 0; gap: 0.8rem; }
  .potencias-breves > div { border: 1px solid var(--borde); background: var(--papel-2); padding: 0.8rem 1rem; }
  .potencias-breves dt { font-size: 0.8rem; color: var(--tinta-2); }
  .potencias-breves dd { margin: 0.1rem 0 0; }
  .potencias-breves dd > strong { font-size: 1.55rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .matiz-dato, .procedencia-dato { display: block; font-size: 0.78rem; line-height: 1.4; margin-top: 0.2rem; }
  .matiz-dato { color: var(--aviso); }
  .procedencia-dato { color: var(--tinta-3); }
  .hardware-breve { max-width: 55rem; margin-top: 0.7rem; }
  .hardware-breve h3 { font-family: var(--sans); font-size: 0.8rem; color: var(--tinta-3); margin: 0 0 0.2rem; }
  .hardware-breve dl { margin: 0; border-top: 1px solid var(--borde); }
  .hardware-breve dl > div { display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(0, 2fr); gap: 0.75rem; padding: 0.65rem 0; border-bottom: 1px solid var(--borde); }
  .hardware-breve dt { font-size: 0.85rem; font-weight: 500; }
  .hardware-breve dd { margin: 0; font-size: 0.85rem; }
  .hardware-breve dd > strong { font-weight: 600; }
  .hardware-breve .etiqueta { margin-left: 0.5rem; }
  .hardware-breve p { margin: 0.4rem 0 0; }
  .aviso-breve { font-size: 0.82rem; color: var(--aviso); background: var(--aviso-fondo); border-left: 2px solid var(--aviso); padding: 0.6rem 0.8rem; margin: 0.8rem 0 0; max-width: 55rem; }
  .ppa-operador { padding-left: 1rem; margin: 0; }
  .ppa-operador li { margin: .6rem 0; font-size: .82rem; }
  .ppa-operador span { display: block; color: var(--tinta-3); font-size: .76rem; }
  .seccion-plegable { border-top: 1px solid var(--borde); min-width: 0; }
  .seccion-plegable > summary { padding: 0.85rem 0; font-size: 0.9rem; font-weight: 600; cursor: pointer; }
  .seccion-plegable > summary span { color: var(--tinta-3); font-size: 0.75rem; font-weight: 400; margin-left: 0.3rem; }
  .seccion-plegable:target { scroll-margin-top: 5rem; }
  .seccion-plegable:target > summary { color: var(--acento); }
  .contenido-plegable { padding-bottom: 1rem; font-size: 0.9rem; }
  .contenido-plegable > p:last-child { margin-bottom: 0; }
  .contenido-plegable .tarjeta { border: 0; padding: 0; background: transparent; box-shadow: none; }
  .contenido-plegable .tarjeta + .tarjeta { margin-top: 1.3rem; }
  .pares .etiqueta { margin-left: 0.3rem; }
  @media (max-width: 560px) {
    .ficha-cabecera h1 { font-size: 1.65rem; }
    .hardware-breve dl > div { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; }
    .identidad-breve { gap: 0.2rem 0.7rem; }
    .potencias-breves dd > strong { font-size: 1.35rem; }
  }

  .ficha-cabecera {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--borde);
    margin-bottom: 1rem;
  }

  .ficha-cabecera h1 {
    margin: 0.5rem 0 0.25rem;
  }

  .ficha-cabecera .etiqueta + .etiqueta {
    margin-left: 0.4rem;
  }

  .dos-columnas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    gap: 2rem;
    align-items: start;
    padding-bottom: 3rem;
  }

  .lateral {
    display: grid;
    gap: 0;
    min-width: 0;
  }

  .titulo-lateral {
    font-family: var(--sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tinta-3);
    margin: 0 0 0.6rem;
  }

  .pares {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem 0.8rem;
    margin: 0;
    font-size: 0.87rem;
  }

  .pares dt {
    color: var(--tinta-3);
  }

  .pares dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .unidad {
    font-weight: 600;
    font-size: 0.85rem;
  }

  /* Qué debilita el respaldo de esta ficha, no la definición del nivel. */
  .motivos-confianza {
    list-style: none;
    padding: 0;
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--tinta-3);
  }

  .motivos-confianza li {
    padding-left: 0.8rem;
    text-indent: -0.8rem;
  }

  .motivos-confianza li::before {
    content: '· ';
  }

  .mono {
    font-family: var(--mono);
    font-size: 0.9em;
  }

  .fuentes {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--borde);
  }

  .incertidumbres {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .incertidumbres li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.9rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--borde);
    font-size: 0.9rem;
  }

  .incertidumbres strong {
    color: var(--aviso);
    font-weight: 600;
    font-size: 0.82rem;
    overflow-wrap: anywhere;
    line-height: 1.5;
  }

  sup a {
    font-size: 0.7em;
    padding: 0 0.1em;
  }

  @media (max-width: 860px) {
    .dos-columnas {
      /* `1fr` a secas conserva `min-width: auto` y el contenido ancho estira
         la columna; `minmax(0, 1fr)` le permite encogerse. */
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .lateral {
      position: static;

    }

    .incertidumbres li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  /* En pantallas estrechas la etiqueta va encima: con dos columnas, textos
     largos como el de refrigeración quedaban en una columna de 20 caracteres. */
  @media (max-width: 560px) {
    .pares {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .pares dt {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 0.5rem;
    }

    .pares dt:first-of-type {
      margin-top: 0;
    }
  }

  .normas-afectan {
    list-style: none;
    padding: 0;
    max-width: 46rem;
  }

  .normas-afectan li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--borde);
  }

  .normas-afectan li:last-child {
    border-bottom: 0;
  }

  .normas-afectan p {
    margin: 0.3rem 0 0;
  }

  .normas-afectan .cabecera-norma {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
  }
</style>
