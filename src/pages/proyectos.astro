---
import Base from '../layouts/Base.astro'
import sitios from '../data/sitios.json'
import {
  ESTADO_ETIQUETA,
  ORDEN_ESTADOS,
  CONFIANZA_ETIQUETA,
  fechaLegible,
  numero,
  slug,
} from '../lib/etiquetas.js'

const ordenados = [...sitios].sort((a, b) => {
  const pa = ORDEN_ESTADOS.indexOf(a.estado)
  const pb = ORDEN_ESTADOS.indexOf(b.estado)
  if (pa !== pb) return pa - pb
  return (b.resumen_potencia.it?.valor_mw ?? -1) - (a.resumen_potencia.it?.valor_mw ?? -1)
})
---

<Base
  titulo="Todos los proyectos"
  descripcion="Listado completo de los centros de datos registrados en España peninsular, con estado, potencia y trazabilidad."
>
  <div class="contenedor">
    <h1>Todos los proyectos</h1>
    <p class="sumario">
      {numero(sitios.length)} emplazamientos registrados. Las columnas de potencia son magnitudes
      distintas y no se suman entre sí: un guion significa que la fuente no publica ese dato, nunca
      que valga cero.
    </p>

    <div class="controles">
      <input id="busca" type="search" placeholder="Filtrar por nombre, operador, municipio…" autocomplete="off" />
      <span id="contador" class="pequeno silencio"></span>
    </div>

    <div class="tabla-envoltorio">
      <table id="tabla">
        <thead>
          <tr>
            <th data-orden="nombre">Emplazamiento</th>
            <th data-orden="operador">Operador</th>
            <th data-orden="ubicacion">Ubicación</th>
            <th data-orden="estado">Estado</th>
            <th class="num" data-orden="it">MW IT</th>
            <th class="num" data-orden="conexion">MW conexión</th>
            <th class="num" data-orden="sintipo">MW s/tipo</th>
            <th data-orden="confianza">Confianza</th>
            <th data-orden="verificacion">Verificado</th>
          </tr>
        </thead>
        <tbody>
          {ordenados.map((s) => (
            <tr
              data-busca={[s.nombre, s.operador, s.ubicacion.municipio, s.ubicacion.ccaa, ...s.alias]
                .filter(Boolean)
                .join(' ')
                .toLowerCase()}
              data-nombre={s.nombre}
              data-operador={s.operador ?? ''}
              data-ubicacion={s.ubicacion.municipio ?? ''}
              data-estado={String(ORDEN_ESTADOS.indexOf(s.estado))}
              data-it={s.resumen_potencia.it?.valor_mw ?? -1}
              data-conexion={s.resumen_potencia.conexion_red?.valor_mw ?? -1}
              data-sintipo={s.resumen_potencia.no_especificado?.valor_mw ?? -1}
              data-confianza={['alta', 'media', 'baja'].indexOf(s.confianza)}
              data-verificacion={s.ultima_verificacion}
            >
              <td>
                <a href={`/proyecto/${s.id}`}>{s.nombre}</a>
                {s.incertidumbres.length > 0 && (
                  <span class="marca-incert" title={`${s.incertidumbres.length} incertidumbre(s) documentada(s)`}>!</span>
                )}
              </td>
              <td>{s.operador ? <a href={`/compania/${slug(s.operador)}`}>{s.operador}</a> : <span class="silencio">—</span>}</td>
              <td>
                {s.ubicacion.municipio ?? <span class="silencio">—</span>}
                <span class="pequeno silencio"><br />{s.ubicacion.ccaa}</span>
              </td>
              <td><span class={`etiqueta estado-${s.estado}`}><span class="punto"></span>{ESTADO_ETIQUETA[s.estado]}</span></td>
              <td class="num">{numero(s.resumen_potencia.it?.valor_mw, 1) ?? <span class="silencio">—</span>}</td>
              <td class="num">{numero(s.resumen_potencia.conexion_red?.valor_mw, 1) ?? <span class="silencio">—</span>}</td>
              <td class="num">{numero(s.resumen_potencia.no_especificado?.valor_mw, 1) ?? <span class="silencio">—</span>}</td>
              <td><span class={`confianza-${s.confianza}`}>{CONFIANZA_ETIQUETA[s.confianza].replace('Confianza ', '')}</span></td>
              <td class="pequeno silencio">{fechaLegible(s.ultima_verificacion)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>

<script>
  const tabla = document.getElementById('tabla')
  const cuerpo = tabla.querySelector('tbody')
  const filas = [...cuerpo.rows]
  const busca = document.getElementById('busca')
  const contador = document.getElementById('contador')

  const actualizarContador = () => {
    const visibles = filas.filter((f) => f.style.display !== 'none').length
    contador.textContent = visibles === filas.length ? `${filas.length} proyectos` : `${visibles} de ${filas.length}`
  }

  busca.addEventListener('input', () => {
    const t = busca.value.trim().toLowerCase()
    for (const f of filas) f.style.display = !t || f.dataset.busca.includes(t) ? '' : 'none'
    actualizarContador()
  })

  let ultimo = null
  let asc = false
  for (const th of tabla.querySelectorAll('th[data-orden]')) {
    th.addEventListener('click', () => {
      const clave = th.dataset.orden
      asc = ultimo === clave ? !asc : clave === 'nombre' || clave === 'operador' || clave === 'ubicacion'
      ultimo = clave
      const numerico = ['estado', 'it', 'conexion', 'sintipo', 'confianza'].includes(clave)
      const ordenadas = [...filas].sort((a, b) => {
        const va = a.dataset[clave]
        const vb = b.dataset[clave]
        const r = numerico ? Number(va) - Number(vb) : String(va).localeCompare(String(vb), 'es')
        return asc ? r : -r
      })
      for (const f of ordenadas) cuerpo.appendChild(f)
      for (const otro of tabla.querySelectorAll('th[data-orden]')) otro.removeAttribute('aria-sort')
      th.setAttribute('aria-sort', asc ? 'ascending' : 'descending')
    })
  }

  actualizarContador()
</script>

<style>
  .controles {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1.5rem 0 0.9rem;
  }

  .controles input {
    flex: 1;
    max-width: 26rem;
  }

  th[data-orden] {
    cursor: pointer;
    user-select: none;
  }

  th[data-orden]:hover {
    color: var(--tinta);
  }

  th[aria-sort]::after {
    content: ' ▾';
  }

  th[aria-sort='ascending']::after {
    content: ' ▴';
  }

  .marca-incert {
    display: inline-block;
    margin-left: 0.35rem;
    width: 1rem;
    height: 1rem;
    line-height: 1rem;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 50%;
    color: var(--aviso);
    border: 1px solid currentColor;
    cursor: help;
  }
</style>
