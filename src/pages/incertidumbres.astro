---
import Base from '../layouts/Base.astro'
import Listado from '../components/Listado.astro'
import sitios from '../data/sitios.json'
import { campoLegible, ESTADO_ETIQUETA, ORDEN_ESTADOS, POTENCIA_ETIQUETA, numero, slug } from '../lib/etiquetas.js'
const entradas = sitios.flatMap((s) => s.incertidumbres.map((u, i) => ({
  sitio: s, campo: u.campo, etiqueta: campoLegible(u.campo), descripcion: u.descripcion,
  id: `${s.id}-${slug(u.campo)}-${i + 1}`, fuentes: u.fuentes.map((id) => s.fuentes.find((f) => f.id === id)).filter(Boolean),
})))
const grupos = [...new Set(entradas.map((e) => e.etiqueta))].map((etiqueta) => ({ etiqueta, ancla: slug(etiqueta), n: entradas.filter((e) => e.etiqueta === etiqueta).length })).sort((a, b) => b.n - a.n)
const afectados = new Set(entradas.map((e) => e.sitio.id)).size
const discrepancias = sitios.flatMap((s) => Object.entries(s.resumen_potencia).filter(([, r]) => r?.discrepancia).map(([tipo, r]) => ({ sitio: s, tipo, ...r })))
const filtros = [
  { nombre: 'campo', etiqueta: 'Dato afectado', opciones: grupos.map((g) => ({ valor: g.ancla, etiqueta: `${g.etiqueta} (${g.n})` })) },
  { nombre: 'estado', etiqueta: 'Estado del proyecto', opciones: ORDEN_ESTADOS.filter((e) => entradas.some((u) => u.sitio.estado === e)).map((e) => ({ valor: e, etiqueta: ESTADO_ETIQUETA[e] })) },
]
const ordenes = [{ valor: 'nombre', etiqueta: 'Proyecto' }, { valor: 'etiqueta', etiqueta: 'Dato afectado' }, { valor: 'verificacion', etiqueta: 'Verificación más reciente', direccion: 'desc' }]
---
<Base titulo="Incertidumbres" descripcion="Busca contradicciones y datos que faltan en los centros de datos registrados, con la explicación y las fuentes de cada caso.">
  <div class="contenedor">
    <h1>Incertidumbres</h1>
    <p class="sumario">{numero(entradas.length)} lagunas y contradicciones documentadas en {afectados} de {sitios.length} emplazamientos. Abre cada entrada para consultar el detalle y sus fuentes.</p>
    {discrepancias.length > 0 && <details class="discrepancias"><summary>{discrepancias.length} magnitudes de potencia con cifras que no coinciden</summary>
      <div class="tabla-envoltorio"><table class="tabla-fichas"><thead><tr><th>Proyecto</th><th>Magnitud</th><th>Rango observado</th></tr></thead><tbody>
        {discrepancias.map((d) => <tr><td><a href={`/proyecto/${d.sitio.id}#potencia`}>{d.sitio.nombre}</a></td><td data-etiqueta="Magnitud">{POTENCIA_ETIQUETA[d.tipo] ?? d.tipo}</td><td data-etiqueta="Rango observado">{numero(d.minimo_observado, 1)} a {numero(d.maximo_observado, 1)} MW</td></tr>)}
      </tbody></table></div>
    </details>}
    <nav class="grupos" aria-label="Tipos de incertidumbre">{grupos.map((g) => <a id={g.ancla} href={`?campo=${g.ancla}#listado`}>{g.etiqueta} <span class="silencio">{g.n}</span></a>)}</nav>
    <Listado nombre="incertidumbres" filtros={filtros} ordenes={ordenes} porPagina={20}>
      <ul class="entradas">{entradas.map((e) => <li id={e.id} data-list-item data-busca={`${e.sitio.nombre} ${e.sitio.operador ?? ''} ${e.sitio.ubicacion.ccaa ?? ''} ${e.etiqueta} ${e.descripcion}`}
        data-nombre={e.sitio.nombre} data-etiqueta={e.etiqueta} data-campo={slug(e.etiqueta)} data-estado={e.sitio.estado} data-verificacion={e.sitio.ultima_verificacion ?? ''}>
        <details><summary><span>{e.sitio.nombre}</span><span class="campo">{e.etiqueta}</span></summary>
          <p class="descripcion">{e.descripcion}</p>
          <p class="pequeno"><a href={`/proyecto/${e.sitio.id}#incertidumbres`}>Ver proyecto</a> · <a href={`#${e.id}`}>Enlace a esta entrada</a> · {ESTADO_ETIQUETA[e.sitio.estado]}</p>
          {e.fuentes.length > 0 && <p class="pequeno silencio">Fuentes: {e.fuentes.map((f, i) => <>{i > 0 && ' · '}<a href={f.url} rel="noopener nofollow" target="_blank">{f.editor ?? f.titulo}</a></>)}</p>}
        </details>
      </li>)}</ul>
    </Listado>
  </div>
</Base>
<style>
  .grupos { display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: .76rem; margin: 1.2rem 0; }
  .grupos a { scroll-margin-top: 6rem; }
  .entradas { list-style: none; padding: 0; margin: 0; max-width: 60rem; }
  .entradas li { border-bottom: 1px solid var(--borde); scroll-margin-top: 6rem; }
  .entradas li:target { background: var(--acento-suave); }
  .entradas summary { cursor: pointer; padding: .8rem 0; font-size: .92rem; }
  .campo { color: var(--tinta-3); font-size: .75rem; margin-left: .65rem; }
  .descripcion { color: var(--tinta-2); font-size: .91rem; margin: .2rem 0 .6rem; max-width: 54rem; }
  .discrepancias { margin: 1.25rem 0; }
  .discrepancias summary { cursor: pointer; font-size: .86rem; }
  @media(max-width: 540px) { .campo { display: block; margin: .25rem 0 0 1rem; } }
</style>
