---
import Base from '../layouts/Base.astro'
import Listado from '../components/Listado.astro'
import companias from '../data/companias.json'
import { ESTADO_ETIQUETA, ORDEN_ESTADOS, numero } from '../lib/etiquetas.js'
import Termino from '../components/Termino.astro'
const regiones = [...new Set(companias.flatMap((c) => c.ccaas))].sort((a, b) => a.localeCompare(b, 'es'))
const filtros = [{ nombre: 'region', etiqueta: 'Comunidad', opciones: regiones.map((r) => ({ valor: r, etiqueta: r })) }]
const ordenes = [{ valor: 'nombre', etiqueta: 'Operador' }, { valor: 'emplazamientos', etiqueta: 'Más emplazamientos', numerico: true, direccion: 'desc' }, { valor: 'it', etiqueta: 'Más MW IT operativos', numerico: true, direccion: 'desc' }]
---
<Base titulo="Operadores" descripcion="Operadores de centros de datos documentados en España, con sus emplazamientos y capacidad.">
  <div class="contenedor">
    <h1>Operadores</h1>
    <p class="sumario">{numero(companias.length)} operadores con emplazamientos documentados.</p>
    <p class="pequeno"><a href="/inversion">Propietarios y grupos cotizados</a></p>
    <Listado nombre="operadores" filtros={filtros} ordenes={ordenes} porPagina={25}>
      <div class="tabla-envoltorio"><table class="tabla-fichas">
        <thead><tr><th>Operador</th><th class="num">Emplazamientos</th><th>Por estado</th><th class="num"><Termino id="mw-it">MW IT</Termino> operativos</th><th class="num">Con dato IT</th><th>Comunidades</th></tr></thead>
        <tbody>{companias.map((c) => <tr data-list-item data-busca={`${c.nombre} ${c.ccaas.join(' ')}`} data-nombre={c.nombre} data-emplazamientos={c.emplazamientos} data-it={c.potencia.it.sitios_con_dato ? c.potencia.it.total_mw : ''} data-region={c.ccaas.join('|')}>
          <td><a href={`/compania/${c.slug}`}>{c.nombre}</a></td>
          <td class="num" data-etiqueta="Emplazamientos">{c.emplazamientos}</td>
          <td data-etiqueta="Por estado"><details class="estados"><summary>{Object.keys(c.por_estado).filter((e) => c.por_estado[e]).length} estados</summary><ul>{ORDEN_ESTADOS.filter((e) => c.por_estado[e]).map((e) => <li>{ESTADO_ETIQUETA[e]}: {c.por_estado[e]}</li>)}</ul></details></td>
          <td class="num" data-etiqueta="MW IT operativos">{c.potencia.it.sitios_con_dato ? numero(c.potencia.it.total_mw, 3) : <span class="silencio">No publicados</span>}</td>
          <td class="num pequeno" data-etiqueta="Con dato IT">{c.potencia.it.sitios_con_dato}/{c.emplazamientos_en_potencia ?? c.emplazamientos}</td>
          <td class="pequeno" data-etiqueta="Comunidades">{c.ccaas.join(', ') || 'Sin determinar'}</td>
        </tr>)}</tbody>
      </table></div>
      <p class="pequeno silencio">Capacidad operativa documentada. Consulta otras etapas en la ficha del operador.</p>
    </Listado>
  </div>
</Base>
<style>
  .estados summary { cursor: pointer; font-size: .78rem; white-space: nowrap; }
  .estados ul { margin: .4rem 0; padding-left: 1rem; min-width: 10rem; font-size: .76rem; }
</style>
