---
import Base from '../layouts/Base.astro'
import { CATEGORIAS, TERMINOS, porCategoria } from '../lib/glosario.js'
---

<Base
  titulo="Glosario"
  descripcion="Definiciones de potencia, acceso a la red, refrigeración, cómputo, energía e inversión."
>
  <div class="contenedor">
    <h1>Glosario</h1>
    <p class="sumario">{TERMINOS.length} términos del registro.</p>

    <div class="controles" data-controles-glosario hidden>
      <label for="busca-termino">Buscar término o definición</label>
      <input id="busca-termino" type="search" placeholder="Por ejemplo, MW IT o PPA" autocomplete="off" />
      <span id="contador-termino" class="pequeno silencio" role="status" aria-live="polite" aria-atomic="true"></span>
    </div>
    <p id="vacio-glosario" class="pequeno" hidden>Sin resultados. Prueba otra palabra.</p>
    <nav class="atajos" aria-label="Secciones del glosario">
      {CATEGORIAS.map(([id, nombre]) => (
        <a href={`#${id}`}>{nombre} <span class="silencio">{porCategoria(id).length}</span></a>
      ))}
    </nav>

    {CATEGORIAS.map(([id, nombre]) => (
      <section class="bloque" id={id} data-bloque>
        <h2>{nombre}</h2>
        <dl class="terminos">
          {porCategoria(id).map((t) => (
            <div class="termino" id={t.id} data-busca={`${t.termino} ${(t.alias ?? []).join(' ')} ${t.definicion} ${t.matiz ?? ''}`.toLowerCase()}>
              <dt>{t.termino}</dt>
              <dd>
                <p>{t.definicion}</p>
                {t.matiz && <details class="matiz"><summary>Matiz</summary><p>{t.matiz}</p></details>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <p class="pequeno" style="margin-bottom:3rem"><a href="/red-electrica">Red eléctrica</a> · <a href="/renovables">Energía y contratos</a> · <a href="/metodologia">Metodología</a></p>
  </div>
</Base>

<script>
  const entrada = document.getElementById('busca-termino')
  const contador = document.getElementById('contador-termino')
  const fichas = [...document.querySelectorAll('.termino[data-busca]')]
  const bloques = [...document.querySelectorAll('[data-bloque]')]
  const normalizar = (texto) => String(texto).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es')
  document.querySelector('[data-controles-glosario]').hidden = false
  const actualizar = (guardar = true) => {
    const palabras = normalizar(entrada.value.trim()).split(/\s+/).filter(Boolean)
    let visibles = 0
    for (const ficha of fichas) {
      const encaja = palabras.every((p) => normalizar(ficha.dataset.busca).includes(p))
      ficha.hidden = !encaja
      if (encaja) visibles++
    }
    for (const bloque of bloques) bloque.hidden = ![...bloque.querySelectorAll('.termino')].some((f) => !f.hidden)
    contador.textContent = `${visibles} de ${fichas.length} términos`
    document.getElementById('vacio-glosario').hidden = visibles > 0
    if (guardar) {
      const url = new URL(location.href)
      if (entrada.value.trim()) url.searchParams.set('q', entrada.value.trim())
      else url.searchParams.delete('q')
      history.replaceState(null, '', url)
    }
  }
  const revelar = () => {
    if (!location.hash) return
    let destino
    try { destino = document.getElementById(decodeURIComponent(location.hash.slice(1))) } catch { return }
    if (destino?.closest('[data-bloque]') && (destino.hidden || destino.closest('[data-bloque]').hidden)) {
      entrada.value = ''
      actualizar()
      requestAnimationFrame(() => destino.scrollIntoView({ block: 'start' }))
    }
  }
  entrada.addEventListener('input', () => actualizar())
  window.addEventListener('popstate', () => { entrada.value = new URL(location.href).searchParams.get('q') ?? ''; actualizar(false); revelar() })
  window.addEventListener('hashchange', revelar)
  entrada.value = new URL(location.href).searchParams.get('q') ?? ''
  actualizar(false)
  revelar()
</script>

<style>
  .termino[hidden], .bloque[hidden] { display: none; }
  .controles[hidden] { display: none; }
  .controles label { font-size: .76rem; color: var(--tinta-3); }
  .controles {
    display: flex;
    align-items: center;
    gap: .5rem .9rem;
    flex-wrap: wrap;
    margin: 1.4rem 0 1.2rem;
  }

  .controles input {
    flex: 1;
    max-width: 24rem;
  }

  .atajos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    border-top: 1px solid var(--borde);
    border-bottom: 1px solid var(--borde);
    padding: 0.7rem 0;
    font-size: 0.78rem;
  }

  .bloque {
    margin-top: 2.6rem;
    scroll-margin-top: 4.5rem;
  }

  .bloque h2 {
    margin-bottom: 0.15rem;
  }

  .terminos {
    margin: 1.2rem 0 0;
    border-top: 1px solid var(--borde);
  }

  .termino {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 0 1.6rem;
    border-bottom: 1px solid var(--borde);
    padding: 0.85rem 0;
    scroll-margin-top: 4.5rem;
  }

  .termino:target {
    background: var(--acento-suave);
    box-shadow: -0.6rem 0 0 var(--acento-suave), 0.6rem 0 0 var(--acento-suave);
  }

  dt {
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 600;
  }

  dd {
    margin: 0;
    max-width: 46rem;
  }

  dd p {
    margin: 0;
    color: var(--tinta-2);
    font-size: 0.88rem;
  }

  .matiz summary { cursor: pointer; font-size: .76rem; color: var(--tinta-3); }
  .matiz p { margin-top: .4rem; }
  .matiz {
    margin-top: 0.4rem;
    padding-left: 0.7rem;
    border-left: 2px solid var(--borde-fuerte);
    color: var(--tinta-3) !important;
    font-size: 0.84rem !important;
  }

  @media (max-width: 700px) {
    .termino {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
