---
import Base from '../../layouts/Base.astro'
import Cartera from '../../components/Cartera.astro'
import InventarioProyectos from '../../components/InventarioProyectos.astro'
import companias from '../../data/companias.json'
import sitios from '../../data/sitios.json'
import { ORDEN_ESTADOS, fechaLegible } from '../../lib/etiquetas.js'
import { nombreProyecto } from '../../lib/nombres.js'

export function getStaticPaths() {
  return companias.map((c) => ({ params: { slug: c.slug }, props: { compania: c } }))
}

const { compania: c } = Astro.props
const propios = sitios
  .filter((s) => c.sitios.includes(s.id))
  .sort((a, b) => ORDEN_ESTADOS.indexOf(a.estado) - ORDEN_ESTADOS.indexOf(b.estado))

// Emplazamientos de otros operadores en los que esta compañía consta como
// propietario o cliente ancla: relaciones que la vista por operador no captura.
const relacionados = sitios.filter(
  (s) => !c.sitios.includes(s.id) && (s.propietario === c.nombre || s.cliente_ancla === c.nombre),
)

const fuentesTotales = new Set(propios.flatMap((s) => s.fuentes.map((f) => f.url))).size
const conIncertidumbre = propios.filter((s) => s.incertidumbres.length > 0)
const ultima = propios.map((s) => s.ultima_verificacion).sort().at(-1)
---

<Base
  titulo={c.nombre}
  descripcion={`Emplazamientos de ${c.nombre} registrados en España, con estado, potencia y fuentes.`}
>
  <div class="contenedor">
    <p class="migas"><a href="/companias">Operadores</a></p>
    <h1>{c.nombre}</h1>
    <p class="sumario">{c.emplazamientos} {c.emplazamientos === 1 ? 'emplazamiento registrado' : 'emplazamientos registrados'} en {c.ccaas.length} {c.ccaas.length === 1 ? 'comunidad' : 'comunidades'}.</p>
    <p class="pequeno silencio">{fuentesTotales} fuentes · Última ficha revisada: {fechaLegible(ultima)}</p>
    <p class="pequeno"><a href={`/?o=${encodeURIComponent(c.nombre)}`}>Ver en el mapa →</a></p>

    <Cartera cartera={c} />

    <h2>Emplazamientos</h2>
    <InventarioProyectos sitios={propios} mostrarOperador={false} />

    {relacionados.length > 0 && (
      <>
        <h2>Otros emplazamientos vinculados</h2>
        <p class="pequeno silencio">
          Operados por terceros, con {c.nombre} como propietario o cliente ancla.
        </p>
        <ul class="lista-simple">
          {relacionados.map((s) => (
            <li>
              <a href={`/proyecto/${s.id}`}>{nombreProyecto(s)}</a>
              <span class="silencio pequeno">
                · operado por {s.operador}
                {s.cliente_ancla === c.nombre ? ' · cliente ancla' : ' · propietario'}
              </span>
            </li>
          ))}
        </ul>
      </>
    )}

    {conIncertidumbre.length > 0 && (
      <details class="incertidumbres-compania">
        <summary>Incertidumbres en {conIncertidumbre.length} de {propios.length} emplazamientos</summary>
        <ul class="lista-simple">
          {conIncertidumbre.map((s) => <li>
            <a href={`/proyecto/${s.id}#incertidumbres`}>{nombreProyecto(s)}</a>
            <span class="silencio pequeno"> · {s.incertidumbres.length} entradas</span>
          </li>)}
        </ul>
        <p class="pequeno"><a href={`/incertidumbres?q=${encodeURIComponent(c.nombre)}`}>Ver incertidumbres</a></p>
      </details>
    )}

  </div>
</Base>

<style>
  .incertidumbres-compania { margin: 1.5rem 0; }
  .incertidumbres-compania summary { cursor: pointer; }
  .lista-simple {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 1rem;
    font-size: 0.9rem;
  }

  .lista-simple li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--borde);
  }
</style>
