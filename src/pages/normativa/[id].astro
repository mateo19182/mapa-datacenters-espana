---
import Base from '../../layouts/Base.astro'
import Fuente from '../../components/Fuente.astro'
import Glosa from '../../components/Glosa.astro'
import normativa from '../../data/normativa.json'
import sitios from '../../data/sitios.json'
import { tituloNorma } from '../../lib/normativa-presentacion.js'
import { fechaLegible, slug } from '../../lib/etiquetas.js'
import { AMBITO_ETIQUETA, RANGO_ETIQUETA, ESTADO_NORMA_ETIQUETA, ESTADO_NORMA_DESCRIPCION, MATERIA_ETIQUETA, ROL_ETIQUETA, POSTURA_ETIQUETA, VINCULO_NORMA_ETIQUETA } from '../../lib/normativa.js'

export function getStaticPaths() {
  return normativa.map((n) => ({ params: { id: n.id }, props: { norma: n } }))
}
const { norma: n } = Astro.props
const hoy = new Date().toISOString().slice(0, 10)
const pendiente = ['consulta_previa', 'audiencia_publica', 'en_tramitacion', 'propuesta'].includes(n.estado)
const bajoControl = n.estado === 'adoptada_en_control'
const indice = new Map(n.fuentes.map((f, i) => [f.id, i + 1]))
const refs = (ids) => (ids ?? []).map((id) => indice.get(id)).filter(Boolean).sort((a, b) => a - b)
const primero = (texto) => texto?.split(/(?<=[.!?])\s+/)[0] ?? ''
const extracto = (texto, maximo = 160) => texto.length <= maximo ? texto : `${texto.slice(0, maximo).replace(/\s+\S*$/, '')}…`
const lecturas = import.meta.glob('../../contenido/normativa/*.md', { eager: true })
const Lectura = lecturas[`../../contenido/normativa/${n.id}.md`]?.Content
const hitos = [...(n.hitos ?? [])].sort((a, b) => b.fecha.localeCompare(a.fecha))
const pasados = hitos.filter((h) => h.fecha <= hoy)
const futuros = hitos.filter((h) => h.fecha > hoy).reverse()
const ultimo = pasados.find((h) => !h.previsto)
const relacionadas = (n.relacionadas ?? []).map((id) => normativa.find((o) => o.id === id)).filter(Boolean)
const porId = new Map(sitios.map((s) => [s.id, s]))
const vinculo = (v) => {
  if (v.tipo === 'proyecto') { const s = porId.get(v.ref); return { texto: s?.nombre ?? v.ref, href: s ? `/proyecto/${s.id}` : null } }
  if (v.tipo === 'region') return { texto: v.ref, href: `/region/${slug(v.ref)}` }
  if (v.tipo === 'nudo') return { texto: v.ref, href: '/red-electrica' }
  return { texto: null, href: null }
}
---

<Base titulo={n.titulo} descripcion={n.resumen}>
  <div class="contenedor">
    <p class="migas"><a href="/normativa">Normativa</a> · {AMBITO_ETIQUETA[n.ambito]}</p>
    <h1>{tituloNorma(n)}</h1>
    <p class="etiquetas"><span class={`etiqueta estado-norma-${n.estado}`}><span class="punto" aria-hidden="true"></span>{ESTADO_NORMA_ETIQUETA[n.estado]}</span><span class="pequeno silencio">Verificada el {fechaLegible(n.ultima_verificacion)}</span></p>
    <p class="sumario"><Glosa texto={primero(n.resumen)} /></p>
    {pendiente && n.estado !== 'consulta_previa' && <p class="nota pequeno"><strong>Sin aprobar.</strong> Los requisitos de esta ficha son propuestas y no están en vigor. Los plazos ligados a una eventual entrada en vigor todavía no han comenzado.</p>}
    {n.estado === 'consulta_previa' && <p class="nota pequeno"><strong>Consulta previa.</strong> Se recaban aportaciones para una futura iniciativa normativa. Todavía no hay una propuesta articulada ni requisitos aplicables.</p>}
    {bajoControl && <p class="nota pequeno"><strong>Adoptada por la Comisión.</strong> Sigue bajo control de Parlamento y Consejo, pendiente de publicación y entrada en vigor. Los requisitos del acto adoptado todavía no son aplicables.</p>}
    {n.estado === 'aprobada_no_aplicable' && <p class="nota pequeno">Aprobada y publicada, con aplicación diferida. Consulta la fecha y el ámbito de cada requisito.</p>}
    {n.estado === 'en_vigor_en_tramitacion' && <p class="nota pequeno">La norma está en vigor. Su tramitación parlamentaria puede modificar el texto.</p>}

    <div class="resumen-actual">
      {ultimo && <div><h2>Última novedad</h2><p class="pequeno"><time datetime={ultimo.fecha}>{fechaLegible(ultimo.fecha)}</time> · {ultimo.hito}{refs(ultimo.fuentes).length > 0 && <sup>{refs(ultimo.fuentes).map((r, i) => <>{i > 0 && ','}<a href={`#fuente-${n.fuentes[r - 1].id}`}>{r}</a></>)}</sup>}</p></div>}
      {n.por_que_importa && <div><h2>Efecto práctico</h2><p class="pequeno"><Glosa texto={primero(n.por_que_importa)} /></p></div>}
    </div>
    <nav class="secciones" aria-label="En esta ficha">
      {n.obligaciones.length > 0 && <a href="#dice">{pendiente ? 'Requisitos propuestos' : bajoControl ? 'Texto adoptado' : 'Requisitos'}</a>}
      {hitos.length > 0 && <a href="#hitos">Cronología</a>}
      {n.incertidumbres.length > 0 && <a href="#incertidumbres">Incertidumbres</a>}
      <a href="#fuentes">Fuentes</a>
    </nav>

    <details class="bloque" id="identificacion"><summary>Texto oficial y estado completo</summary>
      {n.titulo_oficial && <p class="pequeno">{n.titulo_oficial}</p>}
      {n.resumen !== primero(n.resumen) && <p class="pequeno"><Glosa texto={n.resumen} /></p>}
      <dl class="ficha">
        <div><dt>Estado</dt><dd>{ESTADO_NORMA_DESCRIPCION[n.estado]}</dd></div>
        <div><dt>Rango</dt><dd>{RANGO_ETIQUETA[n.rango] ?? n.rango}</dd></div>
        {n.boletin && <div><dt>Boletín</dt><dd>{n.boletin}{n.referencia && ` · ${n.referencia}`}</dd></div>}
        {n.fecha_aprobacion && <div><dt>Aprobación</dt><dd>{fechaLegible(n.fecha_aprobacion)}</dd></div>}
        {n.fecha_publicacion && <div><dt>Publicación</dt><dd>{fechaLegible(n.fecha_publicacion)}</dd></div>}
        {n.fecha_entrada_vigor && <div><dt>Entrada en vigor</dt><dd>{fechaLegible(n.fecha_entrada_vigor)}</dd></div>}
        {n.url_oficial && <div><dt>Texto</dt><dd><a href={n.url_oficial} rel="noopener nofollow" target="_blank">Documento original</a></dd></div>}
        <div><dt>Materias</dt><dd>{n.materias.map((m) => MATERIA_ETIQUETA[m] ?? m).join(' · ')}</dd></div>
        {n.ccaa.length > 0 && <div><dt>Comunidades</dt><dd>{n.ccaa.map((c, i) => <>{i > 0 && ', '}<a href={`/region/${slug(c)}`}>{c}</a></>)}</dd></div>}
      </dl>
      {n.estado_detalle && <p class="pequeno"><Glosa texto={n.estado_detalle} /></p>}
    </details>

    {n.obligaciones.length > 0 && <section id="dice"><h2>{pendiente ? 'Requisitos propuestos' : bajoControl ? 'Contenido del acto adoptado' : 'Requisitos y ámbito'}</h2>
      <p class="pequeno silencio">{pendiente ? 'Borrador sin aprobar. Los umbrales y plazos pueden cambiar.' : bajoControl ? 'Acto adoptado por la Comisión, todavía sin entrar en vigor.' : 'Umbrales y plazos del texto registrado.'} Cada cifra conserva su unidad original.</p>
      <div class="tabla-envoltorio"><table class="tabla-fichas requisitos">
        <thead><tr><th>Destinatario</th><th>Requisito</th><th>Umbral</th><th>Plazo</th><th>Fuente</th></tr></thead>
        <tbody>{n.obligaciones.map((o) => <tr>
          <td class="pequeno" data-etiqueta="Destinatario">{o.quien}</td>
          <td data-etiqueta="Requisito">{o.que.length > 180 ? <details><summary>{extracto(o.que)}</summary><p class="pequeno"><Glosa texto={o.que} /></p></details> : <Glosa texto={o.que} />}</td>
          <td class="pequeno" data-etiqueta="Umbral">{o.umbral ?? 'Sin umbral especificado'}</td>
          <td class="pequeno" data-etiqueta="Plazo">{o.plazo ?? 'Sin plazo especificado'}</td>
          <td data-etiqueta="Fuente">{refs(o.fuentes).map((r, i) => <>{i > 0 && ', '}<a href={`#fuente-${n.fuentes[r - 1].id}`}>{r}</a></>)}</td>
        </tr>)}</tbody>
      </table></div>
    </section>}

    {hitos.length > 0 && <section id="hitos"><h2>Cronología</h2>
      <ol class="hitos">{[...futuros, ...pasados.slice(0, 3)].map((h) => <li class:list={['hito', h.fecha > hoy && 'futuro']}><p class="fecha"><time datetime={h.fecha}>{fechaLegible(h.fecha)}</time>{(h.fecha > hoy || h.previsto) && <span class="por-venir">{h.fecha > hoy ? 'Previsto' : 'Previsto, sin confirmar'}</span>}</p><p>{h.hito}{refs(h.fuentes).length > 0 && <sup>{refs(h.fuentes).map((r, i) => <>{i > 0 && ','}<a href={`#fuente-${n.fuentes[r - 1].id}`}>{r}</a></>)}</sup>}</p></li>)}</ol>
      {pasados.length > 3 && <details class="historial"><summary>Ver {pasados.length - 3} hitos anteriores</summary><ol class="hitos">{pasados.slice(3).map((h) => <li class="hito"><p class="fecha"><time datetime={h.fecha}>{fechaLegible(h.fecha)}</time>{h.previsto && <span class="por-venir">Previsto, sin confirmar</span>}</p><p>{h.hito}{refs(h.fuentes).length > 0 && <sup>{refs(h.fuentes).map((r, i) => <>{i > 0 && ','}<a href={`#fuente-${n.fuentes[r - 1].id}`}>{r}</a></>)}</sup>}</p></li>)}</ol></details>}
    </section>}

    {n.incertidumbres.length > 0 && <details class="bloque" id="incertidumbres"><summary>Incertidumbres documentadas · {n.incertidumbres.length}</summary>
      <ul class="incertidumbres">{n.incertidumbres.map((u) => <li><strong class="campo">{u.campo}</strong><p class="pequeno"><Glosa texto={u.descripcion} />{refs(u.fuentes).length > 0 && <sup>{refs(u.fuentes).map((r, i) => <>{i > 0 && ','}<a href={`#fuente-${n.fuentes[r - 1].id}`}>{r}</a></>)}</sup>}</p></li>)}</ul>
    </details>}

    {(n.por_que_importa || Lectura) && <details class="bloque" id="lectura"><summary>Análisis y efecto práctico</summary>
      <p class="pequeno silencio">Interpretación editorial a partir de las fuentes de la ficha.</p>
      {n.por_que_importa && <p class="importa"><Glosa texto={n.por_que_importa} /></p>}
      {Lectura && <div class="prosa"><Lectura /></div>}
    </details>}

    {n.actores.length > 0 && <details class="bloque" id="actores"><summary>Actores y posiciones · {n.actores.length}</summary>
      <div class="actores">{n.actores.map((a) => <article class="tarjeta actor"><p class="cabecera-actor"><strong>{a.nombre}</strong><span class={`etiqueta postura-${a.postura}`}>{POSTURA_ETIQUETA[a.postura]}</span><span class="pequeno silencio">{ROL_ETIQUETA[a.rol] ?? a.rol}</span></p>{a.voz && <p class="pequeno silencio">{a.voz}</p>}{a.resumen && <p class="pequeno">{a.resumen}</p>}{a.cita && <blockquote>{a.cita}</blockquote>}{refs(a.fuentes).length > 0 && <p class="pequeno silencio">Fuentes {refs(a.fuentes).map((r, i) => <>{i > 0 && ', '}<a href={`#fuente-${n.fuentes[r - 1].id}`}>{r}</a></>)}</p>}</article>)}</div>
    </details>}

    {n.afecta.length > 0 && <details class="bloque" id="afecta"><summary>Vínculos con el mapa · {n.afecta.length}</summary>
      <ul class="vinculos">{n.afecta.map((v) => { const d = vinculo(v); return <li><p><span class="etiqueta silencio">{VINCULO_NORMA_ETIQUETA[v.tipo]}</span>{' '}{d.href ? <a href={d.href}>{d.texto}</a> : d.texto && <strong>{d.texto}</strong>}</p><p class="pequeno"><Glosa texto={v.como} />{refs(v.fuentes).length > 0 && <sup>{refs(v.fuentes).map((r, i) => <>{i > 0 && ','}<a href={`#fuente-${n.fuentes[r - 1].id}`}>{r}</a></>)}</sup>}</p></li> })}</ul>
    </details>}

    {relacionadas.length > 0 && <details class="bloque" id="relacionadas"><summary>Normas relacionadas · {relacionadas.length}</summary><ul class="pequeno relacionadas">{relacionadas.map((r) => <li><a href={`/normativa/${r.id}`}>{tituloNorma(r)}</a> <span class="silencio">· {ESTADO_NORMA_ETIQUETA[r.estado]}</span></li>)}</ul></details>}

    <details class="bloque" id="fuentes"><summary>Fuentes · {n.fuentes.length}</summary><ol class="fuentes">{n.fuentes.map((f, i) => <Fuente fuente={f} numero={i + 1} />)}</ol></details>
  </div>
</Base>

<style>
  h1 { max-width: 58rem; }
  .etiquetas, .secciones { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; }
  .etiquetas { margin-bottom: 1rem; }
  .secciones { font-size: 0.85rem; margin: 1rem 0 1.5rem; }
  .resumen-actual { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr)); border-block: 1px solid var(--borde); gap: 1rem; padding: 1rem 0; }
  .resumen-actual h2 { margin: 0 0 0.4rem; font-family: var(--sans); font-size: 0.75rem; color: var(--tinta-3); }
  .resumen-actual p { margin: 0; }
  .resumen-actual time { font-weight: 600; }
  .ficha { display: grid; gap: 1px; grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); background: var(--borde); border: 1px solid var(--borde); border-radius: var(--radio); overflow: hidden; margin: 1rem 0; }
  .ficha > div { background: var(--papel); padding: 0.7rem 0.9rem; }
  .ficha dt { font-size: 0.72rem; color: var(--tinta-3); margin-bottom: 0.2rem; }
  .ficha dd { margin: 0; font-size: 0.88rem; }
  section { margin: 2rem 0; }
  section > h2 { font-size: 1.25rem; }
  .bloque { margin: 0.4rem 0; border-top: 1px solid var(--borde); padding: 1rem 0; }
  .bloque:last-child { margin-bottom: 3rem; }
  .bloque > summary { cursor: pointer; font-family: var(--serif); font-size: 1.1rem; }
  .bloque[open] > summary { margin-bottom: 1rem; }
  .requisitos summary { cursor: pointer; font-size: 0.85rem; }
  .requisitos details p { margin: 0.7rem 0 0; }
  .hitos { list-style: none; padding: 0; margin: 1rem 0; max-width: 52rem; }
  .hito { display: grid; grid-template-columns: 10rem 1fr; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--borde); }
  .hito p { margin: 0; font-size: 0.85rem; }
  .hito .fecha { color: var(--tinta-3); font-variant-numeric: tabular-nums; }
  .hito.futuro .fecha { color: var(--construccion); }
  .por-venir { display: block; font-size: 0.7rem; }
  .historial summary { cursor: pointer; font-size: 0.85rem; color: var(--acento); }
  .actores { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr)); align-items: start; }
  .actor p { margin: 0 0 0.4rem; }
  .cabecera-actor { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: baseline; }
  .postura-favorable { color: var(--op); }
  .postura-critica { color: var(--permisos); }
  .postura-contraria { color: var(--cancelado); }
  .postura-neutral, .postura-sin_constar { color: var(--tinta-3); }
  .actor blockquote { margin: 0.5rem 0; padding-left: 0.8rem; border-left: 2px solid var(--borde-fuerte); color: var(--tinta-2); font-size: 0.87rem; }
  .vinculos, .incertidumbres, .relacionadas, .fuentes { list-style: none; padding: 0; max-width: 52rem; }
  .vinculos li, .incertidumbres li { padding: 0.7rem 0; border-bottom: 1px solid var(--borde); }
  .vinculos li:last-child, .incertidumbres li:last-child { border-bottom: 0; }
  .vinculos p, .incertidumbres p { margin: 0.3rem 0 0; }
  .campo { font-size: 0.8rem; color: var(--tinta-3); }
  .relacionadas li { margin-bottom: 0.35rem; }
  .importa { max-width: 46rem; }
  @media (max-width: 32rem) { .hito { grid-template-columns: 1fr; gap: 0.15rem; } }
</style>
