---
import Base from '../../layouts/Base.astro'
import normativa from '../../data/normativa.json'
import { fechaLegible } from '../../lib/etiquetas.js'
import { AMBITO_ETIQUETA, ESTADO_NORMA_ETIQUETA, ESTADO_NORMA_DESCRIPCION, MATERIA_ETIQUETA, ordenarNormas } from '../../lib/normativa.js'
import Glosa from '../../components/Glosa.astro'
import { tituloNorma, efectoNorma, etiquetaHitoNorma, calendarioNormas } from '../../lib/normativa-presentacion.js'
import ExploradorEnergia from '../../components/ExploradorEnergia.astro'

const hoy = new Date().toISOString().slice(0, 10)
const normas = ordenarNormas(normativa)
const calendario = calendarioNormas(normas, hoy)
const ultimoHito = (n) => [...(n.hitos ?? [])].filter((h) => !h.previsto && h.fecha <= hoy).sort((a, b) => b.fecha.localeCompare(a.fecha))[0]
const opciones = (campo, etiquetas) => [...new Set(normas.map((n) => n[campo]).filter(Boolean))].map((v) => ({ valor: v, etiqueta: etiquetas[v] ?? v }))
const filtros = [
  { clave: 'estado', etiqueta: 'Estado', opciones: opciones('estado', ESTADO_NORMA_ETIQUETA) },
  { clave: 'ambito', etiqueta: 'Ámbito', opciones: opciones('ambito', AMBITO_ETIQUETA) },
]
const ordenes = [
  { clave: 'prioridad', etiqueta: 'Normas en seguimiento primero', tipo: 'numero' },
  { clave: 'fecha', etiqueta: 'Verificación más reciente', desc: true },
  { clave: 'nombre', etiqueta: 'Nombre' },
]
---

<Base titulo="Normativa" descripcion="Estado, últimas novedades y efecto práctico de las normas que afectan a los centros de datos en España.">
  <div class="contenedor">
    <h1>Normativa</h1>
    <p class="sumario">Qué está en vigor, qué sigue en tramitación y cómo afecta a los proyectos.</p>

    <h2 id="normas">Consultar normas</h2>
    <ExploradorEnergia id="explorador-normativa" nombre="normas" filtros={filtros} ordenes={ordenes} busqueda="Norma, materia o comunidad…">
      <div class="tabla-envoltorio"><table class="tabla-fichas">
        <thead><tr><th>Norma</th><th>Estado</th><th>Efecto práctico</th><th>Último hito</th><th>Verificada</th></tr></thead>
        <tbody>{normas.map((n, i) => { const ultimo = ultimoHito(n); return <tr id={`norma-${n.id}`} data-registro data-list-item data-busca={[n.titulo, ...n.ccaa, ...n.materias.map((m) => MATERIA_ETIQUETA[m] ?? m)].join(' ')} data-estado={n.estado} data-ambito={n.ambito} data-prioridad={i} data-fecha={n.ultima_verificacion} data-nombre={n.titulo}>
          <td><a href={`/normativa/${n.id}`}>{tituloNorma(n)}</a><span class="pequeno silencio"><br />{AMBITO_ETIQUETA[n.ambito]}{n.ccaa.length > 0 && ` · ${n.ccaa.join(', ')}`}</span></td>
          <td data-etiqueta="Estado"><span class={`etiqueta estado-norma-${n.estado}`} title={ESTADO_NORMA_DESCRIPCION[n.estado]}>{ESTADO_NORMA_ETIQUETA[n.estado]}</span></td>
          <td class="pequeno" data-etiqueta="Efecto práctico"><Glosa texto={efectoNorma(n)} /></td>
          <td class="pequeno ultimo-hito" data-etiqueta="Último hito">{ultimo ? <><time datetime={ultimo.fecha}>{fechaLegible(ultimo.fecha)}</time><br /><a href={`/normativa/${n.id}#hitos`}>{etiquetaHitoNorma(n, ultimo)}</a></> : 'Sin hito publicado'}</td>
          <td class="pequeno silencio" data-etiqueta="Verificada">{fechaLegible(n.ultima_verificacion)}</td>
        </tr> })}</tbody>
      </table></div>
    </ExploradorEnergia>

    {calendario.length > 0 && <section class="calendario" id="calendario" aria-labelledby="proximas-fechas"><h2 id="proximas-fechas">Próximas fechas publicadas</h2>
      <ul class="fechas">{calendario.map((h) => <li><time datetime={h.fecha}>{fechaLegible(h.fecha)}</time><div><p>{h.etiqueta}</p><span class="normas-fecha">{h.normas.map((n, i) => <>{i > 0 && ' · '}<a href={`/normativa/${n.id}#hitos`}>{tituloNorma(n)}</a></>)}</span></div></li>)}</ul>
    </section>}
    <details class="bloque"><summary>Alcance del registro</summary><p class="pequeno">Normas europeas, estatales y autonómicas. Los permisos de proyectos concretos figuran en sus fichas.</p></details>
  </div>
</Base>

<style>
  .tabla-fichas .etiqueta { white-space: normal; }
  .ultimo-hito { max-width: 21rem; }
  .ultimo-hito time { color: var(--tinta-3); }
  .calendario { margin: 2rem 0; }
  .calendario h2 { font-size: 1.1rem; }
  .fechas { list-style: none; padding: 0; max-width: 52rem; }
  .fechas li { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: .6rem 0; border-top: 1px solid var(--borde); font-size: .85rem; }
  .fechas time { color: var(--tinta-3); }
  .fechas p { margin: 0; color: var(--tinta-2); }
  .normas-fecha { font-size: .75rem; }
  .bloque { margin: 0.8rem 0; border-top: 1px solid var(--borde); padding: 1rem 0; }
  .bloque:last-child { margin-bottom: 3rem; }
  .bloque summary { cursor: pointer; font-family: var(--serif); font-size: 1.1rem; }
  .bloque[open] summary { margin-bottom: 1rem; }
  @media (max-width: 540px) { .fechas li { grid-template-columns: 1fr; gap: .2rem; } }
</style>
