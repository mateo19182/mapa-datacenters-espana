---
import { createHash } from 'node:crypto'
import Base from '../layouts/Base.astro'
import Listado from '../components/Listado.astro'
import fuentes from '../data/fuentes.json'
import sitios from '../data/sitios.json'
import { FUENTE_ETIQUETA, fechaLegible, numero } from '../lib/etiquetas.js'
const nombreDe = new Map(sitios.map((s) => [s.id, s.nombre]))
const dominio = (url) => { try { return new URL(url).hostname.replace(/^www\./, '') } catch { return 'Dominio desconocido' } }
const ancla = (f) => `fuente-${createHash('sha256').update(f.url).digest('hex').slice(0, 16)}`
const comprobadas = fuentes.filter((f) => f.enlace).length
const rotas = fuentes.filter((f) => f.enlace?.clase === 'rota').length
const bloqueadas = fuentes.filter((f) => f.enlace?.clase === 'bloqueada').length
const filtros = [
  { nombre: 'tipo', etiqueta: 'Tipo de fuente', opciones: Object.entries(FUENTE_ETIQUETA).filter(([t]) => fuentes.some((f) => f.tipo === t)).map(([valor, etiqueta]) => ({ valor, etiqueta })) },
  { nombre: 'enlace', etiqueta: 'Estado del enlace', opciones: [{ valor: 'viva', etiqueta: 'Responde' }, { valor: 'rota', etiqueta: 'Enlace roto' }, { valor: 'bloqueada', etiqueta: 'Bloquea al comprobador' }, { valor: 'sin-comprobar', etiqueta: 'Sin comprobar' }] },
]
const ordenes = [{ valor: 'titulo', etiqueta: 'Título' }, { valor: 'publicacion', etiqueta: 'Publicación más reciente', direccion: 'desc' }, { valor: 'consulta', etiqueta: 'Consulta más reciente', direccion: 'desc' }, { valor: 'editor', etiqueta: 'Editor' }]
---
<Base titulo="Fuentes" descripcion="Busca las referencias del registro por título, editor, dominio, tipo y estado del enlace. Cada referencia enlaza con sus proyectos.">
  <div class="contenedor">
    <h1>Fuentes</h1>
    <p class="sumario">{numero(fuentes.length)} referencias distintas, enlazadas con los emplazamientos que documentan.</p>
    <p class="pequeno silencio">{comprobadas} de {fuentes.length} enlaces comprobados: {rotas} rotos y {bloqueadas} bloqueados para el comprobador. Un bloqueo automático no confirma que el enlace funcione en el navegador.</p>
    <Listado nombre="fuentes" filtros={filtros} ordenes={ordenes} porPagina={25}>
      <div class="tabla-envoltorio"><table class="tabla-fichas">
        <thead><tr><th>Referencia</th><th>Tipo y acceso</th><th>Publicado</th><th>Documenta</th></tr></thead>
        <tbody>{fuentes.map((f) => (
          <tr id={ancla(f)} data-list-item data-busca={`${f.titulo} ${f.editor ?? ''} ${dominio(f.url)} ${f.usos.map((id) => nombreDe.get(id) ?? id).join(' ')}`}
            data-titulo={f.titulo} data-tipo={f.tipo} data-enlace={f.enlace?.clase ?? 'sin-comprobar'} data-publicacion={f.fecha_publicacion ?? ''} data-consulta={f.fecha_consulta ?? ''} data-editor={f.editor ?? dominio(f.url)}>
            <td><a href={f.url} rel="noopener nofollow" target="_blank">{f.titulo}</a>
              <span class="pequeno silencio editor">{f.editor ? `${f.editor} · ` : ''}{dominio(f.url)}</span>
              <details class="respaldo"><summary>Consulta y cita</summary>
                <p>Consultada: {fechaLegible(f.fecha_consulta) ?? 'sin fecha'} · <a href={`#${ancla(f)}`} aria-label={`Enlace a esta fuente: ${f.titulo}`}>Enlace a esta referencia</a></p>
                {f.cita && <blockquote>{f.cita}</blockquote>}
              </details>
            </td>
            <td class="pequeno" data-etiqueta="Tipo y acceso">{FUENTE_ETIQUETA[f.tipo]}
              {f.enlace?.clase === 'rota' && <span class="acceso rota">Enlace roto</span>}
              {f.enlace?.clase === 'bloqueada' && <span class="acceso">Bloquea al comprobador</span>}
              {!f.enlace && <span class="acceso">Sin comprobar</span>}
            </td>
            <td class="pequeno" data-etiqueta="Publicado">{fechaLegible(f.fecha_publicacion) ?? <span class="silencio">Sin fecha</span>}</td>
            <td class="pequeno" data-etiqueta="Documenta">{f.usos.length > 3 ? <details><summary>{f.usos.length} emplazamientos</summary><ul>{f.usos.map((id) => <li><a href={`/proyecto/${id}`}>{nombreDe.get(id) ?? id}</a></li>)}</ul></details> : f.usos.map((id, i) => <>{i > 0 && ' · '}<a href={`/proyecto/${id}`}>{nombreDe.get(id) ?? id}</a></>)}</td>
          </tr>
        ))}</tbody>
      </table></div>
    </Listado>
  </div>
</Base>
<style>
  td:first-child { max-width: 37rem; }
  .editor { display: block; margin-top: .2rem; }
  .respaldo { margin-top: .4rem; font-size: .78rem; color: var(--tinta-3); }
  .respaldo summary, details summary { cursor: pointer; }
  blockquote { margin: .5rem 0; padding: .2rem 0 .2rem .75rem; border-left: 2px solid var(--borde); color: var(--tinta-2); }
  .acceso { display: block; font-size: .7rem; color: var(--tinta-3); margin-top: .25rem; }
  .rota { color: var(--cancelado); }
  td ul { padding-left: 1.1rem; }
  tr:target { background: var(--acento-suave); }
</style>
