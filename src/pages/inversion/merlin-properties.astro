---
import Base from '../../layouts/Base.astro'
import sitios from '../../data/sitios.json'
import Termino from '../../components/Termino.astro'

const idsMerlin = [
  'merlin-edged-getafe-mad01',
  'merlin-edged-getafe-2',
  'merlin-edged-tres-cantos',
  'merlin-barcelona-zona-franca',
  'merlin-edged-ribera-baja-arasur',
  'merlin-botorrita-zaragoza-wind',
  'merlin-edged-navalmoral-de-la-mata',
  'merlin-edged-valdecaballeros',
]

const sitiosMerlin = idsMerlin.map((id) => sitios.find((sitio) => sitio.id === id)).filter(Boolean)
const porId = new Map(sitiosMerlin.map((sitio) => [sitio.id, sitio]))

const estado = {
  operativo: 'Operativo',
  parcialmente_operativo: 'Operativo parcial',
  en_construccion: 'En construcción',
  permisos_concedidos: 'Con permisos',
  en_tramitacion: 'En tramitación',
  anunciado: 'Anunciado',
}

const activos = [
  { id: 'merlin-edged-getafe-mad01', corto: 'Getafe 1', mw: '20', capa: 'Fase I', certeza: 'alta' },
  { id: 'merlin-barcelona-zona-franca', corto: 'Barcelona', mw: '15 / 22', capa: 'Fase I', certeza: 'alta' },
  { id: 'merlin-edged-ribera-baja-arasur', corto: 'Arasur', mw: '118 / 300', capa: 'Fases I–III', certeza: 'media' },
  { id: 'merlin-edged-getafe-2', corto: 'Getafe 2', mw: '20 / 48', capa: 'Fase II', certeza: 'media' },
  { id: 'merlin-edged-tres-cantos', corto: 'Tres Cantos', mw: 's/d', capa: 'Fase II', certeza: 'media' },
  { id: 'merlin-botorrita-zaragoza-wind', corto: 'Zaragoza WIND', mw: '144', capa: 'Fase III', certeza: 'alta' },
  { id: 'merlin-edged-navalmoral-de-la-mata', corto: 'Navalmoral', mw: '20 / hasta 1.400', capa: 'Opción', certeza: 'baja' },
  { id: 'merlin-edged-valdecaballeros', corto: 'Valdecaballeros', mw: 'hasta 1.000', capa: 'Opción', certeza: 'baja' },
].map((activo) => ({ ...activo, sitio: porId.get(activo.id) }))

const precio = 13.40
const nta = 15.99
const ffo = 0.55
const dividendo = 0.42
const descuentoNta = ((nta - precio) / nta) * 100
const pFfo = precio / ffo
const rentabilidadFfo = (ffo / precio) * 100
const rentabilidadDividendo = (dividendo / precio) * 100
const decimal = (valor, decimales = 1) => valor.toLocaleString('es-ES', {
  minimumFractionDigits: decimales,
  maximumFractionDigits: decimales,
})

const fases = [
  { nombre: 'Fase I', mw: 64, inversion: 614, gri: 97, estabilizacion: '2027', color: 'var(--m-verde)' },
  { nombre: 'Fase II', mw: 254, inversion: 2756, gri: 397, estabilizacion: '2030', color: 'var(--m-cian)' },
  { nombre: 'Fase III', mw: 406, inversion: 4406, gri: 646, estabilizacion: '2032', color: 'var(--m-ambar)' },
]

const totalMw = fases.reduce((total, fase) => total + fase.mw, 0)
const totalInversion = fases.reduce((total, fase) => total + fase.inversion, 0)
const totalGri = fases.reduce((total, fase) => total + fase.gri, 0)
const ycTotal = (totalGri / totalInversion) * 100

const matriz = [0.75, 0.9, 1].map((captura) => ({
  captura,
  valores: [0.055, 0.0625, 0.07].map((yieldSalida) => (ycTotal * captura) / (yieldSalida * 100)),
}))
---

<Base
  titulo="MERLIN Properties como inversión"
  descripcion="Análisis técnico de MERLIN Properties: valoración, Plan MEGA, cartera española de centros de datos, financiación, riesgos y sensibilidad."
>
  <article class="informe-merlin">
    <header class="portada">
      <div class="portada-interior">
        <p class="migas"><a href="/inversion">Tesis de inversión</a> · MERLIN Properties</p>
        <div class="portada-meta">
          <span class="terminal">BME: MRL</span>
          <span>Nota de inversión</span>
          <span>31 agosto 2026</span>
        </div>
        <div class="portada-grid">
          <div>
            <p class="sobrelinea">Infraestructura digital dentro de una <Termino id="socimi">SOCIMI</Termino> diversificada</p>
            <h1>MERLIN Properties<br /><span>como inversión</span></h1>
            <p class="tesis-corta">
              El mercado ya reconoce parte del giro hacia centros de datos, pero no paga todavía el{' '}
              <Termino id="epra-nta">EPRA NTA</Termino>. La oportunidad existe. También el riesgo de un plan con €7.800 millones de
              inversión total mientras la mayor parte de la renta aún no ha llegado a caja.
            </p>
          </div>
          <aside class="veredicto" aria-label="Conclusión de inversión">
            <span class="veredicto-etiqueta">Lectura</span>
            <strong>Selectiva</strong>
            <p>
              Activos y balance sólidos. Precio razonable frente a <Termino id="epra-nta">NTA</Termino>,
              exigente frente a <Termino id="ffo">FFO</Termino> actual.
              La tesis depende de ejecutar, energizar y alquilar la Fase II y la Fase III.
            </p>
            <dl>
            <div><dt>Precio de referencia</dt><dd>€{decimal(precio, 2)}</dd></div>
              <div><dt><Termino id="epra-nta">EPRA NTA</Termino></dt><dd>€{decimal(nta, 2)}</dd></div>
              <div><dt>Horizonte</dt><dd>2027–2032</dd></div>
            </dl>
          </aside>
        </div>
      </div>
    </header>

    <nav class="indice" aria-label="Índice del informe">
      <div class="pagina">
        <a href="#tesis">Tesis</a>
        <a href="#valoracion">Valoración</a>
        <a href="#mega">Plan MEGA</a>
        <a href="#activos">Activos</a>
        <a href="#tecnica">Técnica</a>
        <a href="#riesgos">Riesgos</a>
        <a href="#fuentes">Fuentes</a>
      </div>
    </nav>

    <div class="pagina cuerpo">
      <section class="panel-metricas" aria-label="Indicadores principales">
        <div class="metrica metrica-principal">
          <span><Termino id="descuento-nta">Descuento a EPRA NTA</Termino></span>
          <strong>{decimal(descuentoNta)}%</strong>
          <small>€{decimal(precio, 2)} frente a €{decimal(nta, 2)} por acción</small>
        </div>
        <div class="metrica">
          <span><Termino id="ffo">Precio / FFO</Termino> 2026e</span>
          <strong>{decimal(pFfo)}×</strong>
          <small>Guía de €{decimal(ffo, 2)} por acción</small>
        </div>
        <div class="metrica">
          <span><Termino id="ffo">Rentabilidad FFO</Termino></span>
          <strong>{decimal(rentabilidadFfo)}%</strong>
          <small>Inversa del múltiplo anterior</small>
        </div>
        <div class="metrica">
          <span>Distribución 2025</span>
          <strong>{decimal(rentabilidadDividendo)}%</strong>
          <small>€{decimal(dividendo, 2)} por acción sobre el precio</small>
        </div>
        <div class="metrica">
          <span><Termino id="ltv">LTV</Termino></span>
          <strong>24,5%</strong>
          <small>Después de ampliar capital</small>
        </div>
      </section>

      <p class="corte-datos">
        Precio de cierre del 31 de agosto de 2026. Datos financieros a 30 de junio de 2026. Las
        cifras de emplazamientos proceden del registro de este proyecto, verificado hasta el 31 de
        agosto de 2026. Esto es análisis, no asesoramiento financiero.
      </p>

      <section id="tesis" class="seccion seccion-dos">
        <div class="titulo-lateral">
          <span>01</span>
          <h2>La tesis en una página</h2>
        </div>
        <div class="contenido">
          <p class="entradilla">
            MERLIN ya no es solo una cartera de oficinas, centros comerciales y logística. Los data
            centers representan €2.103 millones de <Termino id="gav">GAV</Termino>, un 15,6% del total, y explicaron cerca del
            80% de la creación de valor del primer semestre. Sin embargo, el negocio digital aportó
            solo €28,1 millones de rentas brutas en esos seis meses. El valor se ha adelantado al flujo.
          </p>

          <div class="tesis-grid">
            <div class="caso caso-favor">
              <p class="caso-titulo">Qué tiene que salir bien</p>
              <ul>
                <li>La Fase I alcanza €97 millones de renta estabilizada en 2027.</li>
                <li>Los 160 MW alquilados o prealquilados se entregan en calendario.</li>
                <li>La potencia concedida en Arasur y Zaragoza se convierte en edificios operativos.</li>
                <li>El coste de capital queda muy por debajo del 14,4%–15,8% de <Termino id="yield-on-cost">yield on cost</Termino> bruto.</li>
              </ul>
            </div>
            <div class="caso caso-contra">
              <p class="caso-titulo">Qué puede romperla</p>
              <ul>
                <li>Retrasos en red, licencias o equipos desplazan rentas y reducen la <Termino id="tir">TIR</Termino>.</li>
                <li>Más <Termino id="ampliacion-capital">ampliaciones de capital</Termino> diluyen el FFO por acción antes de estabilizar rentas.</li>
                <li>Unos pocos <Termino id="hiperescalar">hiperescaladores</Termino> concentran capacidad y poder de negociación.</li>
                <li>Las opciones extremeñas de 1 GW se valoran como proyecto firme cuando aún no lo son.</li>
              </ul>
            </div>
          </div>

          <div class="lectura-clave">
            <span>Mi lectura</span>
            <p>
              A €13,40, la acción ofrece un margen razonable frente al valor neto de activos, pero no
              frente al beneficio recurrente de 2026. Comprarla exige creer que el FFO de 2030 se
              parecerá mucho menos al de hoy. Ese es el contrato implícito con el accionista.
            </p>
          </div>
        </div>
      </section>

      <section id="valoracion" class="seccion seccion-dos">
        <div class="titulo-lateral">
          <span>02</span>
          <h2>Dos valoraciones que cuentan historias distintas</h2>
        </div>
        <div class="contenido">
          <div class="valoracion-comparada">
            <div>
              <span class="kicker">Balance</span>
              <strong>0,84× NTA</strong>
              <p>
                El precio descuenta un 16,2% sobre €15,99 de EPRA NTA por acción. Si la tasación es
                conservadora y el desarrollo crea valor, el descuento protege. Si los yields de salida
                suben o el capex se desvía, el NTA puede bajar antes de que el descuento cierre.
              </p>
            </div>
            <div>
              <span class="kicker">Caja</span>
              <strong>24,4× FFO</strong>
              <p>
                La guía de €340 millones equivale a €0,55 por acción. No es un múltiplo bajo para una
                inmobiliaria. El mercado está pagando renta futura. Además, el FFO total subió 8,0%
                en el semestre, pero cayó 1,8% por acción tras la ampliación de capital.
              </p>
            </div>
          </div>

          <div class="puente" aria-label="Puente entre precio y NTA">
            <div class="puente-escala"><span>€0</span><span>€8</span><span>€16</span></div>
            <div class="puente-fila">
              <span>Precio</span>
              <div><i style={`width:${(precio / 16) * 100}%`}></i><b>€{decimal(precio, 2)}</b></div>
            </div>
            <div class="puente-fila nta">
              <span>EPRA NTA</span>
              <div><i style={`width:${(nta / 16) * 100}%`}></i><b>€{decimal(nta, 2)}</b></div>
            </div>
          </div>

          <h3>Balance para financiar la obra</h3>
          <div class="balance-grid">
            <dl>
              <div><dt><Termino id="gav">GAV</Termino> total</dt><dd>€13.508m</dd></div>
              <div><dt>Deuda neta</dt><dd>€3.394m</dd></div>
              <div><dt>Liquidez</dt><dd>€2.571m</dd></div>
            </dl>
            <dl>
              <div><dt>Coste medio de deuda</dt><dd>2,71%</dd></div>
              <div><dt>Deuda a tipo fijo</dt><dd>99,8%</dd></div>
              <div><dt>Vencimiento medio</dt><dd>4,0 años</dd></div>
            </dl>
          </div>
          <p class="nota-analista">
            El <Termino id="ltv">LTV</Termino> bajo es una ventaja real, pero se logró en parte con €768 millones de capital nuevo.
            Las acciones pasaron de unos 564 a 620 millones, cerca de un 10% más. El balance soporta{' '}
            <Termino id="capex">capex</Termino>; el accionista soporta la <Termino id="dilucion">dilución</Termino>.
          </p>
        </div>
      </section>

      <section id="mega" class="seccion seccion-dos">
        <div class="titulo-lateral">
          <span>03</span>
          <h2>La máquina económica del Plan MEGA</h2>
        </div>
        <div class="contenido">
          <p class="entradilla">
            Las tres fases suman {totalMw} <Termino id="mw-it">MW IT</Termino>, €{decimal(totalInversion / 1000)} mil millones de
            inversión y €{decimal(totalGri / 1000, 2)} mil millones de renta bruta estabilizada. No son
            magnitudes actuales. Son el objetivo corporativo una vez construida y alquilada la cartera.
          </p>

          <div class="fases" aria-label="Fases del Plan MEGA">
            {fases.map((fase) => (
              <article style={`--fase:${fase.color}`}>
                <div class="fase-cabecera"><span>{fase.nombre}</span><b>{fase.estabilizacion}</b></div>
                <strong>{fase.mw} MW</strong>
                <div class="fase-barra"><i style={`width:${(fase.mw / 406) * 100}%`}></i></div>
                <dl>
                  <div><dt>Inversión</dt><dd>€{fase.inversion.toLocaleString('es-ES')}m</dd></div>
                  <div><dt><Termino id="gri">GRI</Termino> estabilizado</dt><dd>€{fase.gri}m</dd></div>
                  <div><dt><Termino id="yield-on-cost">YoC</Termino> bruto</dt><dd>{decimal((fase.gri / fase.inversion) * 100)}%</dd></div>
                </dl>
              </article>
            ))}
          </div>

          <h3>Sensibilidad de valor sobre coste</h3>
          <p>
            Esta matriz divide el <Termino id="yield-on-cost">yield on cost</Termino> bruto del plan,
            {decimal(ycTotal)}%, por un <Termino id="yield-salida">yield de salida</Termino>. Ajusta antes la renta efectivamente capturada. Un resultado de 2,1× significa que
            el valor bruto estabilizado sería 2,1 veces el coste, antes de financiación, impuestos,
            retrasos y valor temporal del dinero. No es un precio objetivo.
          </p>
          <div class="matriz-envoltorio">
            <table class="matriz">
              <thead>
                <tr><th>Renta capturada</th><th>Yield 5,5%</th><th>Yield 6,25%</th><th>Yield 7,0%</th></tr>
              </thead>
              <tbody>
                {matriz.map((fila) => (
                  <tr>
                    <th>{Math.round(fila.captura * 100)}%</th>
                    {fila.valores.map((valor) => <td class:list={[valor >= 2.2 && 'alto', valor < 1.8 && 'bajo']}>{decimal(valor, 2)}×</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="nota-analista">
            El <Termino id="spread-desarrollo">spread de desarrollo</Termino> es amplio en papel. El tiempo importa: la Fase III no estabiliza
            hasta 2032. Seis años de obra, comercialización y capital inmovilizado reducen mucho una
            comparación directa entre yield on cost y yield de salida.
          </p>
        </div>
      </section>

      <section id="activos" class="seccion seccion-dos">
        <div class="titulo-lateral">
          <span>04</span>
          <h2>Qué existe en España y qué sigue siendo opcional</h2>
        </div>
        <div class="contenido">
          <p class="entradilla">
            El registro del proyecto identifica ocho emplazamientos vinculados a MERLIN en España.
            La tabla conserva cifras rivales cuando las fuentes no permiten reconciliarlas. “Hasta 1 GW”
            describe una capacidad aspiracional de campus, no MW operativos ni renta contratada.
          </p>
          <div class="activos-tabla-envoltorio">
            <table class="activos-tabla">
              <thead>
                <tr><th>Emplazamiento</th><th>Estado</th><th>MW publicados</th><th>Capa</th><th>Lectura</th></tr>
              </thead>
              <tbody>
                {activos.map((activo) => (
                  <tr>
                    <td><a href={`/proyecto/${activo.id}`}>{activo.corto}</a><small>{activo.sitio?.ubicacion?.provincia}</small></td>
                    <td><span class={`estado estado-${activo.sitio?.estado}`}>{estado[activo.sitio?.estado] ?? activo.sitio?.estado}</span></td>
                    <td class="numero">{activo.mw}</td>
                    <td>{activo.capa}</td>
                    <td><span class={`certeza certeza-${activo.certeza}`}>{activo.certeza}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="no-sumar">
            <div class="no-sumar-signo">≠</div>
            <div>
              <h3>Las cifras que no se deben sumar</h3>
              <p>
                En Arasur, 118 MW de capacidad crítica publicada y 300 MW de capacidad potencial son
                dos vistas del mismo campus. En Barcelona, 15 MW de potencia del centro y 22 MW de
                capacidad eléctrica total miden cosas distintas. En Botorrita, 227,4 MW de demanda
                garantizada no son los 144 MW IT del edificio. Sumarlas infla la cartera.
              </p>
            </div>
          </div>

          <h3>Prueba de calidad del pipeline</h3>
          <div class="calidad">
            <div><span>Renta visible</span><strong>160 MW</strong><p>Alquilados o prealquilados a julio de 2026.</p></div>
            <div><span>Obra corporativa</span><strong>724 MW</strong><p>Plan MEGA, fases I a III en Iberia.</p></div>
            <div><span>Opcionalidad</span><strong>2,4 GW</strong><p>Máximos publicados para Navalmoral y Valdecaballeros. No incluidos en MEGA.</p></div>
          </div>
        </div>
      </section>

      <section id="tecnica" class="seccion seccion-dos">
        <div class="titulo-lateral">
          <span>05</span>
          <h2>La ventaja técnica, y dónde termina</h2>
        </div>
        <div class="contenido">
          <div class="diagrama" aria-label="Cadena física y económica del centro de datos">
            <div><span>Red 220/400 kV</span><small>Permiso y subestación</small></div>
            <b>→</b>
            <div><span>Edificio</span><small>Transformación y respaldo</small></div>
            <b>→</b>
            <div><span>Sala IT</span><small>MW críticos y refrigeración</small></div>
            <b>→</b>
            <div><span>Inquilino</span><small>Contrato y renta por MW</small></div>
          </div>

          <div class="tecnica-grid">
            <article>
              <span>01 / potencia</span>
              <h3>La conexión es el activo escaso</h3>
              <p>
                Un edificio sin energía no produce renta. Getafe 1 está equipado y alquilado, pero
                espera conexiones para generar flujo completo en el cuarto trimestre de 2026. Red
                Eléctrica evalúa capacidad nodal y zonal por criterios estáticos, dinámicos y de
                cortocircuito. Tener suelo no equivale a tener acceso.
              </p>
            </article>
            <article>
              <span>02 / refrigeración</span>
              <h3><Termino id="pue">PUE</Termino> 1,15 y <Termino id="wue">WUE</Termino> 0,00 son objetivos de diseño</h3>
              <p>
                Edged usa circuitos con glicol, enfriadoras de aire y refrigeración secundaria cerrada.
                El sistema admite hasta 500 kW por pasillo caliente y, en Getafe, hasta 200 kW por rack
                con refrigeración líquida. La base documental recoge las declaraciones del operador,
                no mediciones independientes anuales.
              </p>
            </article>
            <article>
              <span>03 / densidad</span>
              <h3>La IA aumenta renta y concentración</h3>
              <p>
                Barcelona aloja 10.224 GPU NVIDIA H200 de CoreWeave. Nebius contrató 18 MW en Getafe.
                Las cargas de alta densidad favorecen edificios preparados para líquido, pero atan
                grandes bloques de capacidad a pocos clientes con ciclos tecnológicos cortos.
              </p>
            </article>
            <article>
              <span>04 / mercado</span>
              <h3>Pipeline no significa oferta entregada</h3>
              <p>
                Colliers estima 385 MW IT operativos en Iberia y más de 2.900 MW en pipeline hasta 2030.
                La diferencia es el punto: licencias, red y equipos deciden quién llega a tiempo. Merlin
                tiene contratos y potencia en varios nodos, una posición mejor que un mero banco de suelo.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section id="riesgos" class="seccion seccion-dos">
        <div class="titulo-lateral">
          <span>06</span>
          <h2>Registro de riesgos para el accionista</h2>
        </div>
        <div class="contenido">
          <div class="riesgos">
            <article><span class="impacto impacto-alto">Alto</span><h3>Financiación y dilución</h3><p>El programa de €7.776 millones equivale a cerca del 94% de la capitalización bursátil actual. La ampliación de marzo cubrió parte de la Fase III, no convierte todo el plan en capex financiado. La señal a vigilar es FFO por acción, no solo FFO total.</p></article>
            <article><span class="impacto impacto-alto">Alto</span><h3>Ejecución eléctrica</h3><p>Potencia concedida, infraestructura ejecutada y conexión energizada son hitos distintos. Cada trimestre de retraso difiere renta y aumenta el coste financiero sin cambiar el MW anunciado.</p></article>
            <article><span class="impacto impacto-medio">Medio</span><h3>Concentración de clientes</h3><p>Contratos de 48 MW reducen el riesgo de vacío, pero crean exposiciones grandes a un inquilino. La calidad del crédito, garantías, duración, escaladores y opciones de salida importan más que el porcentaje prealquilado aislado.</p></article>
            <article><span class="impacto impacto-medio">Medio</span><h3>Yield de salida</h3><p>Los data centers en operación se tasan con yield bruto del 6,2%. Una expansión de 100 puntos básicos reduce en torno a un 14% el valor capitalizado de una renta constante.</p></article>
            <article><span class="impacto impacto-medio">Medio</span><h3>Activos tradicionales</h3><p>El 84% del GAV no es digital. Oficinas, retail y logística siguen determinando ocupación, renta y deuda. La tesis Merlin no es una inversión pura en data centers.</p></article>
            <article><span class="impacto impacto-bajo">Vigilar</span><h3>Promesas de eficiencia</h3><p><Termino id="pue">PUE</Termino> y <Termino id="wue">WUE</Termino> de diseño ayudan en permisos y costes, pero no sustituyen series operativas. El inversor debería pedir consumo medido, disponibilidad y coste de mantenimiento por instalación.</p></article>
          </div>

