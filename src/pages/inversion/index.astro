---
import Base from '../../layouts/Base.astro'
import Glosa from '../../components/Glosa.astro'
import { tesisPublicadas, proximasTesis } from '../../lib/inversion.js'
import { tesisEmpresas } from '../../lib/tesis-inversion/index.js'

const relaciones = (empresa) => [
  ...(empresa.operadores ?? []).map((operador) => ({ ...operador, href: `/compania/${operador.slug}` })),
  ...(empresa.sitios ?? []).map((sitio) => ({ ...sitio, href: `/proyecto/${sitio.id}` })),
]
const fechaAnalisis = (empresa) => tesisEmpresas[empresa.id]?.fecha ?? '31 agosto 2026'
---

<Base
  titulo="Tesis de inversión"
  descripcion="Análisis fechados de compañías cotizadas expuestas a los centros de datos en España."
>
  <div class="contenedor inversion-indice">
    <p class="migas"><a href="/">Inicio</a></p>
    <header class="cabecera-pagina">
      <div>
        <h1>Tesis de inversión</h1>
        <p class="sumario">{tesisPublicadas.length} exposiciones cotizadas, con precios de cierre del 31 de agosto de 2026.</p>
      </div>
    </header>

    <section aria-label="Tesis publicadas">
      <ul class="publicadas">
        {tesisPublicadas.map((empresa) => (
          <li class="tesis-publicada">
            <div class="empresa">
              <h2><a href={empresa.href}>{empresa.nombre}</a></h2>
              <span class="ticker">{empresa.ticker}</span>
            </div>
            <div class="exposicion">
              <span class="intensidad">Exposición {empresa.intensidad}</span>
              <span>{empresa.tipo}</span>
            </div>
            <div class="fecha"><span>Análisis</span><span>{fechaAnalisis(empresa)}</span></div>
            <a class="enlace-tesis" href={empresa.href}>Leer tesis <span class="sr-only">de {empresa.nombre}</span> →</a>
            <details class="contexto">
              <summary>Contexto y pregunta</summary>
              <p><Glosa texto={empresa.resumen} /></p>
              <p><Glosa texto={empresa.pregunta} /></p>
            </details>
          </li>
        ))}
      </ul>
    </section>

    {proximasTesis.length > 0 && (
      <details class="metodo-inversion">
        <summary>Próximas tesis <span>{proximasTesis.length}</span></summary>
        <p class="pequeno silencio">Orden propuesto, pendiente de investigación.</p>
        <div class="tabla-envoltorio">
          <table>
            <thead><tr><th>Prioridad</th><th>Compañía</th><th>Por qué merece una tesis</th><th>Pregunta central</th><th>En el registro</th></tr></thead>
            <tbody>{proximasTesis.map((empresa, indice) => (
              <tr>
                <td>{indice + 1}</td>
                <td><strong>{empresa.nombre}</strong><br />{empresa.ticker}<br />{empresa.tipo}</td>
                <td><Glosa texto={empresa.resumen} /></td>
                <td><Glosa texto={empresa.pregunta} /></td>
                <td>
                  {relaciones(empresa).map((relacion, i) => <>{i > 0 && ' · '}<a href={relacion.href}>{relacion.nombre}</a></>)}
                  {empresa.fuente && <><br /><a href={empresa.fuente} rel="noopener">Fuente corporativa</a></>}
                </td>
              </tr>
            ))}</tbody>
          </table>
        </div>
      </details>
    )}

    <details class="metodo-inversion" id="metodo">
      <summary>Método y alcance</summary>
      <p>Las tesis relacionan los proyectos documentados con las cuentas, financiación y valoración de cada grupo cotizado.</p>
      <p class="pequeno">El directorio de <a href="/companias">Operadores</a> agrupa marcas operativas. Un propietario cotizado puede no operar ningún centro.</p>
      <ol>
        <li><strong>Exposición física.</strong> Qué emplazamientos, MW y permisos pertenecen a la compañía.</li>
        <li><strong>Traducción financiera.</strong> <Glosa texto="Capex, rentas, contratos, financiación y materialidad dentro del grupo." /></li>
        <li><strong>Valoración.</strong> Qué descuenta la cotización y qué supuestos exige.</li>
        <li><strong>Seguimiento.</strong> Qué datos trimestrales demostrarían que la tesis estaba equivocada.</li>
      </ol>
      <p class="pequeno silencio">Análisis fechados, no recomendaciones personalizadas. Las fichas de proyecto conservan sus propias fechas de verificación.</p>
    </details>
  </div>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .inversion-indice { padding-top: 1px; padding-bottom: 3rem; }
  .cabecera-pagina { margin-bottom: 1.2rem; }
  .publicadas { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--borde-fuerte); }
  .tesis-publicada { display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(10rem, 1.4fr) minmax(7rem, .8fr) auto; gap: .4rem 1.5rem; padding: .9rem 0; border-bottom: 1px solid var(--borde); align-items: center; }
  .empresa h2 { margin: 0 0 .15rem; font-size: 1.12rem; }
  .empresa h2 a { color: var(--tinta); }
  .ticker { color: var(--tinta-3); font: .7rem var(--mono); }
  .exposicion { display: grid; font-size: .78rem; color: var(--tinta-3); }
  .intensidad { color: var(--tinta-2); margin-bottom: .15rem; }
  .fecha { display: grid; font-size: .75rem; color: var(--tinta-2); }
  .fecha > span { font-size: .7rem; color: var(--tinta-3); }
  .enlace-tesis { font-size: .8rem; white-space: nowrap; }
  .contexto { grid-column: 1 / -1; }
  .contexto summary { cursor: pointer; color: var(--tinta-3); font-size: .72rem; }
  .contexto p { max-width: 50rem; font-size: .83rem; margin: .6rem 0 0; color: var(--tinta-2); }
  .metodo-inversion { max-width: 54rem; margin: 1.2rem 0 0; border-top: 1px solid var(--borde); }
  .metodo-inversion > summary { cursor: pointer; font-weight: 600; padding: .8rem 0; font-size: .9rem; }
  .metodo-inversion p, .metodo-inversion li { font-size: .85rem; }
  .metodo-inversion ol { padding-left: 1.2rem; }
  .metodo-inversion li + li { margin-top: .5rem; }
  @media (max-width: 700px) {
    .tesis-publicada { grid-template-columns: minmax(0, 1fr) auto; gap: .4rem 1rem; }
    .empresa { grid-column: 1; grid-row: 1; }
    .enlace-tesis { grid-column: 2; grid-row: 1; }
    .exposicion { grid-column: 1; }
    .fecha { grid-column: 2; font-size: .7rem; text-align: right; }
  }
</style>
