---
import Base from '../../layouts/Base.astro'
import { TESIS_ESTADO, tesisPublicadas, proximasTesis } from '../../lib/inversion.js'

const relaciones = (empresa) => [
  ...(empresa.operadores ?? []).map((operador) => ({ ...operador, href: `/compania/${operador.slug}` })),
  ...(empresa.sitios ?? []).map((sitio) => ({ ...sitio, href: `/proyecto/${sitio.id}` })),
]
---

<Base
  titulo="Tesis de inversión"
  descripcion="Análisis de compañías cotizadas expuestas a la expansión de centros de datos en España, conectados con el registro documental de proyectos."
>
  <div class="contenedor inversion-indice">
    <p class="migas"><a href="/">Inicio</a></p>
    <header class="cabecera-pagina">
      <div>
        <h1>Tesis de inversión</h1>
        <p class="sumario">
          Compañías cotizadas expuestas al despliegue de centros de datos en España. Cada tesis parte
          del registro físico, pero añade cuentas, valoración, estructura de capital y una opinión.
        </p>
      </div>
    </header>

    <p class="nota pequeno">
      <strong>Una capa distinta del registro.</strong> La pestaña <a href="/companias">Compañías</a>{' '}
      agrupa operadores. Esta sección agrupa exposiciones cotizadas. Un mismo grupo puede aparecer
      bajo varias marcas operativas, y un propietario cotizado puede no operar ningún centro.
    </p>

    <section>
      <div class="seccion-cabecera">
        <div><span class="numero-seccion">01</span><h2>Publicadas</h2></div>
        <p>Análisis completos, fechados y con fuentes.</p>
      </div>
      <div class="publicadas">
        {tesisPublicadas.map((empresa) => (
          <article class="tesis-publicada">
            <div>
              <span class="etiqueta">{TESIS_ESTADO[empresa.estado]}</span>
              <h3><a href={empresa.href}>{empresa.nombre}</a></h3>
              <p>{empresa.resumen}</p>
            </div>
            <dl>
              <div><dt>Cotización</dt><dd>{empresa.ticker}</dd></div>
              <div><dt>Exposición</dt><dd>{empresa.intensidad}</dd></div>
              <div><dt>Papel</dt><dd>{empresa.tipo}</dd></div>
            </dl>
            <a class="enlace-tesis" href={empresa.href}>Leer la tesis →</a>
          </article>
        ))}
      </div>
    </section>

    {proximasTesis.length > 0 && (
    <section>
      <div class="seccion-cabecera">
        <div><span class="numero-seccion">02</span><h2>Próximas tesis</h2></div>
        <p>Orden propuesto. Prima la exposición material y la pregunta que el mercado aún no resuelve bien.</p>
      </div>
      <div class="tabla-envoltorio">
        <table class="candidatas">
          <thead>
            <tr><th>Prioridad</th><th>Compañía</th><th>Por qué merece una tesis</th><th>Pregunta central</th><th>En el registro</th></tr>
          </thead>
          <tbody>
            {proximasTesis.map((empresa, indice) => (
              <tr>
                <td class="prioridad" data-etiqueta="Prioridad">0{indice + 1}</td>
                <td data-etiqueta="Compañía"><strong>{empresa.nombre}</strong><small>{empresa.ticker}<br />{empresa.tipo}</small></td>
                <td data-etiqueta="Por qué">{empresa.resumen}</td>
                <td data-etiqueta="Pregunta">{empresa.pregunta}</td>
                <td data-etiqueta="Registro">
                  {relaciones(empresa).map((relacion, i) => <>{i > 0 && ' · '}<a href={relacion.href}>{relacion.nombre}</a></>)}
                  {empresa.fuente && <><br /><a class="fuente-candidata" href={empresa.fuente} rel="noopener">fuente corporativa ↗</a></>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    )}

    <section class="metodo-inversion">
      <h2>Método de cada tesis</h2>
      <ol>
        <li><strong>Exposición física.</strong> Qué emplazamientos, MW y permisos pertenecen de verdad a la compañía.</li>
        <li><strong>Traducción financiera.</strong> Capex, rentas, contratos, financiación y materialidad dentro del grupo.</li>
        <li><strong>Valoración.</strong> Qué descuenta la cotización y qué supuestos exige.</li>
        <li><strong>Falsación.</strong> Qué datos trimestrales demostrarían que la tesis estaba equivocada.</li>
      </ol>
      <p class="pequeno silencio">
        No son recomendaciones personalizadas. Las tesis están fechadas porque precio, cuentas y
        permisos cambian; las fichas del registro conservan sus propias fechas de verificación.
      </p>
    </section>
  </div>
</Base>

<style>
  .inversion-indice { padding-top: 1px; }
  .cabecera-pagina { margin-bottom: 1.5rem; }
  section { margin-top: 3.2rem; }
  .seccion-cabecera { display: flex; justify-content: space-between; gap: 2rem; align-items: baseline; border-bottom: 1px solid var(--borde-fuerte); margin-bottom: 1rem; }
  .seccion-cabecera > div { display: flex; gap: .8rem; align-items: baseline; }
  .seccion-cabecera h2 { margin: 0 0 .45rem; }
  .seccion-cabecera p { max-width: 36rem; margin: 0 0 .55rem; color: var(--tinta-3); font-size: .78rem; }
  .numero-seccion { color: var(--tinta-3); font: .72rem var(--mono); }
  .tesis-publicada { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(16rem, .8fr); gap: 1.5rem 3rem; border: 1px solid var(--borde); border-top: 3px solid var(--acento); padding: 1.4rem; background: var(--papel); }
  .tesis-publicada h3 { font-size: 1.55rem; margin: .7rem 0 .35rem; }
  .tesis-publicada h3 a { color: var(--tinta); }
  .tesis-publicada p { color: var(--tinta-2); max-width: 42rem; }
  .tesis-publicada dl { margin: 0; }
  .tesis-publicada dl div { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--borde); padding: .45rem 0; }
  .tesis-publicada dt { color: var(--tinta-3); font-size: .75rem; }
  .tesis-publicada dd { margin: 0; text-align: right; font-size: .78rem; }
  .enlace-tesis { grid-column: 1 / -1; font-size: .82rem; }
  .candidatas { min-width: 900px; }
  .candidatas td { font-size: .8rem; }
  .candidatas td:nth-child(3), .candidatas td:nth-child(4) { max-width: 18rem; }
  .candidatas strong { display: block; }
  .candidatas small { color: var(--tinta-3); }
  .prioridad { font: 600 .82rem var(--mono); color: var(--acento); }
  .fuente-candidata { color: var(--tinta-3); font-size: .7rem; }
  .metodo-inversion { max-width: 48rem; margin-bottom: 4rem; }
  .metodo-inversion ol { padding-left: 1.2rem; }
  .metodo-inversion li { margin: .55rem 0; }
  @media (max-width: 760px) {
    .seccion-cabecera { display: block; }
    .tesis-publicada { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
