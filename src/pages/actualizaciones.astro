---
import Base from '../layouts/Base.astro'
import actualizaciones from '../data/actualizaciones.json'
import { fechaLegible } from '../lib/etiquetas.js'
const etiquetas = { nuevo: 'Nuevo emplazamiento', proyecto: 'Proyecto', permisos: 'Tramitación', normativa: 'Normativa', red: 'Red eléctrica' }
---
<Base titulo="Últimos cambios" descripcion="Novedades verificadas incorporadas al mapa, con fecha del hecho, fecha de publicación en el registro y fuentes.">
  <div class="contenedor-estrecho cambios">
    <h1>Últimos cambios</h1>
    <p class="sumario">Novedades revisadas e incorporadas al registro. Cada entrada distingue el hecho de su fecha de incorporación.</p>
    <ol class="historial-cambios">
      {actualizaciones.map((entrada) => (
        <li id={entrada.id}>
          <div class="fecha-cambio"><time datetime={entrada.fecha}>{fechaLegible(entrada.fecha)}</time><span>{etiquetas[entrada.tipo]}</span></div>
          <h2>{entrada.titulo}</h2>
          <p>{entrada.resumen}</p>
          {entrada.fecha_hecho && <p class="fecha-hecho">Hecho documentado del <time datetime={entrada.fecha_hecho}>{fechaLegible(entrada.fecha_hecho)}</time>.</p>}
          <div class="enlaces-cambio">{entrada.enlaces.map((enlace) => <a href={enlace.href}>{enlace.texto} →</a>)}</div>
          <details><summary>Fuentes · {entrada.fuentes.length}</summary><ul>{entrada.fuentes.map((fuente) => <li><a href={fuente.url} target="_blank" rel="noopener">{fuente.titulo}</a></li>)}</ul></details>
        </li>
      ))}
    </ol>
    <p class="pequeno silencio">La comprobación de enlaces y las pistas pendientes de verificar no se publican como novedades. <a href="/cobertura">Ver cobertura y trabajo pendiente</a>.</p>
  </div>
</Base>
<style>
  .cambios { padding-block: 1.5rem 2rem; }
  .historial-cambios { list-style: none; margin: 1.75rem 0; padding: 0 0 0 1.35rem; border-left: 1px solid var(--borde-fuerte); }
  .historial-cambios > li { position: relative; border-bottom: 1px solid var(--borde); padding: 0 0 1.25rem; margin: 0 0 1.35rem; }
  .historial-cambios > li::before { content: ''; position: absolute; width: .5rem; height: .5rem; border-radius: 50%; background: var(--acento); left: -1.62rem; top: .4rem; }
  .historial-cambios > li:target { background: var(--acento-suave); outline: .5rem solid var(--acento-suave); }
  h2 { margin: .4rem 0 .5rem; font-size: 1.25rem; }
  .fecha-cambio { display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-size: .74rem; color: var(--tinta-3); }
  .fecha-cambio > span { color: var(--acento); }
  p { font-size: .9rem; margin-bottom: .6rem; }
  .fecha-hecho { font-size: .76rem; color: var(--tinta-3); }
  .enlaces-cambio { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; font-size: .83rem; }
  details { margin-top: .4rem; font-size: .8rem; }
  details ul { padding-left: 1.2rem; }
  details li { margin-bottom: .45rem; }
</style>
