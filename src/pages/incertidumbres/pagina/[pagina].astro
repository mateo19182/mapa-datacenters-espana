---
import Referencias from '../../../components/Referencias.astro'
import { datosReferencias } from '../../../lib/referencias-data.js'
export function getStaticPaths() {
  const datos = datosReferencias('incertidumbres')
  return Array.from({ length: Math.ceil(datos.items.length / datos.porPagina) - 1 }, (_, i) => ({ params: { pagina: String(i + 2) }, props: { pagina: i + 2 } }))
}
const { pagina } = Astro.props
---
<Referencias tipo="incertidumbres" pagina={pagina} />
