---
import Base from '../layouts/Base.astro'
import Listado from '../components/Listado.astro'
import regiones from '../data/regiones.json'
import { numero } from '../lib/etiquetas.js'
const ordenes = [{ valor: 'nombre', etiqueta: 'Comunidad' }, { valor: 'emplazamientos', etiqueta: 'Más emplazamientos', numerico: true, direccion: 'desc' }, { valor: 'it', etiqueta: 'Más MW IT operativos', numerico: true, direccion: 'desc' }]
---
<Base titulo="Regiones" descripcion="Centros de datos documentados por comunidad autónoma, con operadores y cobertura de los MW IT operativos.">
  <div class="contenedor">
    <h1>Regiones</h1>
    <p class="sumario">{regiones.length} comunidades con emplazamientos registrados. El recuento refleja la documentación disponible; consulta la <a href="/cobertura">cobertura</a>.</p>
    <Listado nombre="regiones" ordenes={ordenes}>
      <div class="rejilla">{regiones.map((r) => <article class="tarjeta region" data-list-item data-busca={`${r.nombre} ${r.operadores.join(' ')}`} data-nombre={r.nombre} data-emplazamientos={r.emplazamientos} data-it={r.potencia.it.sitios_con_dato ? r.potencia.it.total_mw : ''}>
        <h2><a href={`/region/${r.slug}`}>{r.nombre}</a></h2>
        <p class="cifra-grande">{r.emplazamientos}<small>{r.emplazamientos === 1 ? 'emplazamiento' : 'emplazamientos'}</small></p>
        <dl class="mini"><dt>MW IT operativos</dt><dd>{r.potencia.it.sitios_con_dato ? `${numero(r.potencia.it.total_mw, 3)} MW` : 'No publicados'}</dd>
          <dt>Con dato IT</dt><dd>{r.potencia.it.sitios_con_dato}/{r.emplazamientos_en_potencia ?? r.emplazamientos} emplazamientos</dd>
          <dt>Operadores</dt><dd>{r.operadores.length}</dd>
        </dl>
      </article>)}</div>
      <p class="pequeno silencio">Solo se agregan cifras identificadas como operativas. Cada región muestra construcción y previsiones por separado.</p>
    </Listado>
  </div>
</Base>
<style>
  .region h2 { font-size: 1.1rem; margin: 0 0 .5rem; }
  .cifra-grande { font-family: var(--serif); font-size: 2rem; line-height: 1; margin: 0 0 .8rem; }
  .cifra-grande small { font-family: var(--sans); font-size: .78rem; color: var(--tinta-3); margin-left: .4rem; }
  .mini { display: grid; grid-template-columns: auto 1fr; gap: .3rem .7rem; margin: 0; font-size: .82rem; }
  .mini dt { color: var(--tinta-3); }.mini dd { margin: 0; }
</style>
