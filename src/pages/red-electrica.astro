---
import Base from '../layouts/Base.astro'
import red from '../data/red.json'
import capacidad from '../data/capacidad.json'
import actuaciones from '../data/actuaciones.json'
import sitios from '../data/sitios.json'
import { fechaLegible, numero } from '../lib/etiquetas.js'
import Termino from '../components/Termino.astro'
import ExploradorEnergia from '../components/ExploradorEnergia.astro'

// El máximo sirve para explorar los criterios publicados. No atribuye a un CPD
// capacidad de un consumo convencional ni permite sumarla con la de otro nudo.
const nudos = capacidad.map((n) => {
  const valores = Object.values(n.disponible_criterio_general_demanda_mw ?? {}).filter((v) => v != null)
  const maximo = valores.length ? Math.max(...valores) : null
  return { ...n, maximo, margen: maximo == null ? 'no_publicado' : maximo > 0 ? 'con_margen' : 'cero' }
})
const comunidades = [...new Set(nudos.map((n) => n.ccaa).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'))
const porCcaa = comunidades.map((ccaa) => {
  const lista = nudos.filter((n) => n.ccaa === ccaa)
  const publicados = lista.map((n) => n.maximo).filter((v) => v != null)
  return {
    ccaa, total: lista.length,
    conMargen: lista.filter((n) => n.margen === 'con_margen').length,
    cero: lista.filter((n) => n.margen === 'cero').length,
    sinDato: lista.filter((n) => n.margen === 'no_publicado').length,
    maximo: publicados.length ? Math.max(...publicados) : null,
  }
})
const conConexion = sitios.filter((s) => s.conexion_electrica?.subestacion)
const subestacionesSituadas = red.filter((s) => s.lat != null && s.lon != null)
const ambitos = { peninsular: 'Península', baleares: 'Baleares', canarias: 'Canarias', ceuta: 'Ceuta', melilla: 'Melilla' }
const fechaDato = [...new Set(capacidad.map((n) => n.fecha_publicacion_dato).filter(Boolean))].sort().at(-1)
const filtros = [
  { clave: 'ccaa', etiqueta: 'Comunidad', todos: 'Todas', opciones: comunidades.map((c) => ({ valor: c, etiqueta: c })) },
  { clave: 'ambito', etiqueta: 'Territorio eléctrico', todos: 'Todos', opciones: Object.entries(ambitos).filter(([valor]) => nudos.some((n) => n.ambito_electrico === valor)).map(([valor, etiqueta]) => ({ valor, etiqueta })) },
  { clave: 'margen', etiqueta: 'Margen publicado', opciones: [
    { valor: 'con_margen', etiqueta: 'Mayor que cero' }, { valor: 'cero', etiqueta: 'Cero en criterios publicados' }, { valor: 'no_publicado', etiqueta: 'Sin dato publicado' },
  ] },
  { clave: 'tension', etiqueta: 'Tensión', opciones: [...new Set(nudos.map((n) => n.tension_kv).filter((v) => v != null))].sort((a, b) => b - a).map((v) => ({ valor: String(v), etiqueta: `${v} kV` })) },
]
const ordenes = [
  { clave: 'maximo', etiqueta: 'Mayor margen publicado', tipo: 'numero', desc: true },
  { clave: 'nombre', etiqueta: 'Nombre' },
  { clave: 'otorgada', etiqueta: 'Más demanda otorgada', tipo: 'numero', desc: true },
  { clave: 'solicitada', etiqueta: 'Más demanda en curso', tipo: 'numero', desc: true },
]
const LIMITANTE = { Est_Dem_Nudo: 'Estabilidad del nudo', Est_Dem_Zona: 'Estabilidad de la zona', WSCR_Nudo: 'Cortocircuito del nudo', Din1_Zona: 'Criterio dinámico de la zona', Din2_Zona: 'Criterio dinámico de la zona' }
const limitante = (n) => n.criterio_limitante_demanda?.split('/').map((c) => LIMITANTE[c] ?? c).join(' · ') ?? n.motivo_no_otorgable ?? 'No publicada'
const mw = (v) => v == null ? 'No publicado' : `${numero(v)} MW`
---

<Base titulo="Red eléctrica" descripcion="Consulta la capacidad de acceso para demanda publicada por Red Eléctrica, por nudo, comunidad y criterio técnico.">
  <div class="contenedor">
    <h1>Red eléctrica</h1>
    <p class="sumario">Capacidad de acceso para demanda en la red de transporte. Filtra por comunidad, tensión y margen publicado.</p>
    <p class="pequeno silencio metadatos">
      Edición REE: {fechaLegible(fechaDato)} · {numero(nudos.length)} nudos publicados ·{' '}
      <a href="https://www.ree.es/es/clientes/consumidor/acceso-conexion/conoce-la-capacidad-de-acceso" target="_blank" rel="noopener">Fuente oficial</a> · <a href="/datos/capacidad.json" download>Descargar JSON</a>
    </p>
    <p class="nota pequeno">MW de acceso, no MW IT. Los márgenes de distintos nudos <Termino id="zona-capacidad">no se suman</Termino>.</p>
    <p class="pequeno silencio">Todos los territorios del CSV; {subestacionesSituadas.length} subestaciones situadas en el mapa. Los nudos sin coordenadas se consultan en la tabla.</p>

    <h2 id="nudos">Consultar nudos</h2>
    <details class="ayuda-criterios"><summary>Cómo interpretar la tabla</summary><p class="pequeno silencio">CEP CH: electrónica de potencia con cumplimiento de huecos de tensión. CEP SH: sin cumplimiento. No CEP: consumo sin electrónica de potencia. El orden inicial usa el mayor valor publicado; consulta el criterio aplicable al diseño del consumo.</p><p class="pequeno silencio">Otorgada: permiso concedido. En curso: solicitud pendiente. No acreditan una instalación construida. Un dato no publicado se distingue de cero.</p></details>
    <ExploradorEnergia id="explorador-nudos" nombre="nudos" filtros={filtros} ordenes={ordenes} busqueda="Nudo o comunidad…">
      <div class="tabla-envoltorio">
        <table class="tabla-fichas">
          <thead><tr><th>Nudo</th><th>Comunidad</th><th class="num">CEP CH</th><th class="num">CEP SH</th><th class="num">No CEP</th><th class="num">Otorgada</th><th class="num">En curso</th></tr></thead>
          <tbody>
            {[...nudos].sort((a, b) => (b.maximo ?? -1) - (a.maximo ?? -1)).map((n) => (
              <tr id={`nudo-${n.id}`} data-registro data-list-item data-busca={`${n.nudo} ${n.ccaa ?? ''} ${ambitos[n.ambito_electrico] ?? ''}`} data-ccaa={n.ccaa ?? ''} data-ambito={n.ambito_electrico ?? ''} data-margen={n.margen} data-tension={String(n.tension_kv ?? '')} data-nombre={n.nudo} data-maximo={n.maximo} data-otorgada={n.otorgada_demanda_rdt_mw} data-solicitada={n.solicitada_en_curso_demanda_rdt_mw}>
                <td><strong>{n.nudo}</strong><span class="pequeno silencio"><br />{n.tension_kv} kV · {ambitos[n.ambito_electrico] ?? 'Territorio sin clasificar'}</span><details class="detalle-nudo"><summary>Limitación y procedencia</summary><p>{limitante(n)}</p>{n.nudo_de_concurso && <p>Capacidad sujeta a concurso.</p>}{n.ambito_electrico === 'canarias' && !n.sistema_electrico && <p>Territorio canario; el sistema insular concreto no está documentado en esta ficha.</p>}<p>{n.subestacion_id ? `Vínculo documentado: ${n.subestacion_id}.` : 'Sin vínculo documentado con una subestación del mapa.'}</p><p>Código REE: {n.codigo_subestacion_ree}. Fila lógica {n.fila_csv_ree} del CSV original.</p></details></td>
                <td class="pequeno" data-etiqueta="Comunidad">{n.ccaa ?? 'No publicada'}</td>
                <td class="num" data-etiqueta="CEP CH">{mw(n.disponible_criterio_general_demanda_mw?.cep_ch)}</td>
                <td class="num" data-etiqueta="CEP SH">{mw(n.disponible_criterio_general_demanda_mw?.cep_sh)}</td>
                <td class="num" data-etiqueta="No CEP">{mw(n.disponible_criterio_general_demanda_mw?.no_cep)}</td>
                <td class="num" data-etiqueta="Demanda otorgada">{mw(n.otorgada_demanda_rdt_mw)}</td>
                <td class="num" data-etiqueta="Demanda en curso">{mw(n.solicitada_en_curso_demanda_rdt_mw)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </ExploradorEnergia>

    <details class="bloque" id="comunidades">
      <summary>Reparto por comunidad autónoma</summary>
      <p class="pequeno silencio">Recuento de nudos y máximo individual entre los tres criterios.</p>
      <div class="tabla-envoltorio"><table class="tabla-fichas">
        <thead><tr><th>Comunidad</th><th class="num">Nudos</th><th class="num">Con margen</th><th class="num">Cero publicado</th><th class="num">Sin dato</th><th class="num">Máximo de un nudo</th></tr></thead>
        <tbody>{porCcaa.map((c) => <tr><td>{c.ccaa}</td><td class="num" data-etiqueta="Nudos">{c.total}</td><td class="num" data-etiqueta="Con margen">{c.conMargen}</td><td class="num" data-etiqueta="Cero publicado">{c.cero}</td><td class="num" data-etiqueta="Sin dato">{c.sinDato}</td><td class="num" data-etiqueta="Máximo de un nudo">{mw(c.maximo)}</td></tr>)}</tbody>
      </table></div>
    </details>

    {actuaciones.length > 0 && <details class="bloque" id="actuaciones"><summary>Actuaciones de red planificadas · {actuaciones.length}</summary>
      <div class="tabla-envoltorio"><table class="tabla-fichas">
        <thead><tr><th>Actuación</th><th>Tipo</th><th>kV</th><th>Horizonte</th><th>Estado</th></tr></thead>
        <tbody>{actuaciones.map((a) => <tr><td>{a.nombre ?? a.id}<span class="pequeno silencio"><br />{[a.municipios, a.ccaa].flat().filter(Boolean).join(', ')}</span></td><td data-etiqueta="Tipo">{a.tipo ?? 'No publicado'}</td><td data-etiqueta="kV">{a.tension_kv ?? 'No publicado'}</td><td data-etiqueta="Horizonte">{a.horizonte ?? 'No publicado'}</td><td data-etiqueta="Estado">{a.estado_tramitacion ?? a.estado ?? 'No publicado'}</td></tr>)}</tbody>
      </table></div>
    </details>}

    {conConexion.length > 0 && <details class="bloque" id="conexiones"><summary>Proyectos con subestación documentada · {conConexion.length}</summary>
      <div class="tabla-envoltorio"><table class="tabla-fichas">
        <thead><tr><th>Proyecto</th><th>Subestación</th><th>kV</th><th>MW solicitados</th><th>MW concedidos</th></tr></thead>
        <tbody>{conConexion.map((s) => <tr><td><a href={`/proyecto/${s.id}`}>{s.nombre}</a></td><td data-etiqueta="Subestación">{s.conexion_electrica.subestacion}</td><td data-etiqueta="kV">{s.conexion_electrica.tension_kv ?? 'No publicado'}</td><td data-etiqueta="MW solicitados">{numero(s.conexion_electrica.mw_solicitados, 1) ?? 'No publicado'}</td><td data-etiqueta="MW concedidos">{numero(s.conexion_electrica.mw_concedidos, 1) ?? 'No publicado'}</td></tr>)}</tbody>
      </table></div>
    </details>}

    <aside class="guia tarjeta"><h2>Entender el acceso a la red</h2><p class="pequeno">Permisos, criterios técnicos, concursos y límites de los datos.</p><a href="/guias/red-electrica">Leer la guía</a><span class="silencio"> · </span><a href="/?capas=lineas,subestaciones">Ver {red.length} subestaciones en el mapa</a></aside>
  </div>
</Base>

<style>
  .metadatos { margin-bottom: 1.2rem; }
  .ayuda-criterios { margin-top: -0.35rem; }
  .ayuda-criterios p { max-width: 45rem; }
  .bloque { margin: 0.8rem 0; padding: 0.9rem 0; border-top: 1px solid var(--borde); }
  .bloque > summary { cursor: pointer; font-family: var(--serif); font-size: 1.1rem; }
  .bloque[open] > summary { margin-bottom: 1rem; }
  .detalle-nudo { font-size: 0.75rem; font-weight: 400; color: var(--tinta-3); margin-top: 0.3rem; }
  .detalle-nudo summary { cursor: pointer; }
  .detalle-nudo p { margin: 0.4rem 0; max-width: 15rem; }
  .guia { margin: 2rem 0 3rem; }
  .guia h2 { margin-top: 0; font-size: 1.15rem; }
  .guia p { margin-bottom: 0.5rem; }
</style>
