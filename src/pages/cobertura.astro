---
import Base from '../layouts/Base.astro'
import { Content as Documento } from '../contenido/cobertura.md'
import pendientes from '../data/pendientes.json'
import resumen from '../data/resumen.json'
import sitios from '../data/sitios.json'
import { numero, slug } from '../lib/etiquetas.js'
import Termino from '../components/Termino.astro'

const proyectos = pendientes.proyectos ?? []
const pistas = pendientes.pistas ?? []

const ORDEN = { alta: 0, media: 1, baja: 2 }
const ordenados = [...proyectos].sort(
  (a, b) => (ORDEN[a.prioridad] ?? 3) - (ORDEN[b.prioridad] ?? 3) || a.municipio.localeCompare(b.municipio, 'es'),
)

const regionesConFicha = new Set(sitios.map((s) => s.ubicacion.ccaa).filter(Boolean))

// Cuántas fichas de cada comunidad citan al menos una fuente oficial: es la
// mejor medida de si existe una vía documental primaria en ese territorio.
const porRegion = [...regionesConFicha]
  .map((ccaa) => {
    const lista = sitios.filter((s) => s.ubicacion.ccaa === ccaa)
    return {
      ccaa,
      total: lista.length,
      oficial: lista.filter((s) => s.fuentes.some((f) => f.tipo === 'oficial')).length,
      exactas: lista.filter((s) => s.ubicacion.precision === 'exacta').length,
      tipada: lista.filter((s) => s.resumen_potencia.it || s.resumen_potencia.conexion_red).length,
      conexion: lista.filter((s) => s.conexion_electrica).length,
    }
  })
  .sort((a, b) => b.total - a.total)

const pct = (n, total) => (total ? Math.round((n / total) * 100) : 0)
---

<Base
  titulo="Cobertura"
  descripcion="Qué cubre este registro, qué le falta, qué contradicciones quedan abiertas y qué no debe concluirse de él."
>
  <div class="contenedor">
    <h1>Cobertura</h1>
    <p class="sumario">
      Qué cubre el registro comunidad por comunidad, y los proyectos que se sabe que faltan.
    </p>

    <div class="nota">
      <strong>Sesgo documental.</strong> El recuento por comunidad depende de lo accesible que sea su
      boletín oficial. Aragón está mejor documentado que Cataluña porque su boletín es consultable,
      no porque tenga más centros de datos.
    </div>

    <h2>Cobertura por comunidad</h2>
    <div class="tabla-envoltorio">
      <table class="tabla-fichas">
        <thead>
          <tr>
            <th>Comunidad</th>
            <th class="num">Fichas</th>
            <th class="num">Con fuente oficial</th>
            <th class="num">Con MW tipificados</th>
            <th class="num">Coordenadas exactas</th>
            <th class="num">Con conexión eléctrica</th>
          </tr>
        </thead>
        <tbody>
          {porRegion.map((r) => (
            <tr>
              <td><a href={`/region/${slug(r.ccaa)}`}>{r.ccaa}</a></td>
              <td class="num" data-etiqueta="Fichas">{r.total}</td>
              <td class="num" data-etiqueta="Fuente oficial">{r.oficial} <span class="silencio pequeno">({pct(r.oficial, r.total)} %)</span></td>
              <td class="num" data-etiqueta="MW tipificados">{r.tipada} <span class="silencio pequeno">({pct(r.tipada, r.total)} %)</span></td>
              <td class="num" data-etiqueta="Coord. exactas">{r.exactas} <span class="silencio pequeno">({pct(r.exactas, r.total)} %)</span></td>
              <td class="num" data-etiqueta="Con conexión">{r.conexion} <span class="silencio pequeno">({pct(r.conexion, r.total)} %)</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="pequeno silencio">
      «Con MW tipificados» son las fichas que publican <Termino id="mw-it">carga TI</Termino> o
      <Termino id="potencia-acceso">potencia de conexión</Termino>, no
      <Termino id="mw-sin-tipificar">MW sin especificar</Termino>. «Con conexión eléctrica», las que
      identifican <Termino id="subestacion">subestación</Termino> o potencia de acceso.
    </p>

    <h2>Lo que se sabe que falta</h2>
    <p>
      {numero(proyectos.length)} proyectos con promotor y municipio conocidos que aún no tienen
      ficha, más {pistas.length} pistas abiertas. Sin verificar en fuente primaria, así que no
      entran en el mapa ni en ningún total.
    </p>

    <div class="tabla-envoltorio">
      <table class="tabla-fichas">
        <thead>
          <tr><th>Municipio</th><th>Comunidad</th><th>Compañía</th><th>Potencia citada</th><th>Prioridad</th></tr>
        </thead>
        <tbody>
          {ordenados.map((p) => (
            <tr>
              <td>
                {p.municipio}
                <span class="pequeno silencio"><br />{p.provincia}</span>
              </td>
              <td class="pequeno" data-etiqueta="Comunidad">{p.ccaa}</td>
              <td data-etiqueta="Compañía">
                {p.compania ?? <span class="silencio">sin promotor identificado</span>}
                {p.nota && <span class="pequeno silencio"><br />{p.nota}</span>}
              </td>
              <td class="pequeno" data-etiqueta="Potencia citada">{p.potencia_citada ?? <span class="silencio">sin cifra</span>}</td>
              <td data-etiqueta="Prioridad"><span class={`prioridad prioridad-${p.prioridad}`}>{p.prioridad}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3>Pistas abiertas</h3>
    <p class="pequeno silencio">
      A estas les falta el municipio, el promotor o ambos.
    </p>
    <ul class="pistas">
      {pistas.map((t) => <li>{t}</li>)}
    </ul>

    <div class="cifras">
      <div class="cifra">
        <dt>Emplazamientos registrados</dt>
        <dd>{numero(resumen.total_emplazamientos)}</dd>
      </div>
      <div class="cifra">
        <dt>Con contradicciones documentadas</dt>
        <dd>{resumen.emplazamientos_con_incertidumbres}<small>véase <a href="/incertidumbres">incertidumbres</a></small></dd>
      </div>
      <div class="cifra">
        <dt>Pendientes de fichar</dt>
        <dd>{proyectos.length}</dd>
      </div>
      <div class="cifra">
        <dt>Sin ubicación publicada</dt>
        <dd>{resumen.sin_region}</dd>
      </div>
    </div>

    <hr />

    <article class="prosa">
      <Documento />
    </article>
  </div>
</Base>

<style>
  .prioridad {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    border: 1px solid currentColor;
  }

  .prioridad-alta {
    color: var(--cancelado);
  }

  .prioridad-media {
    color: var(--permisos);
  }

  .prioridad-baja {
    color: var(--tinta-3);
  }

  .pistas {
    font-size: 0.9rem;
    color: var(--tinta-2);
    max-width: 46rem;
    padding-left: 1.1rem;
  }

  .pistas li {
    margin-bottom: 0.35em;
  }

  .prosa {
    padding-bottom: 3rem;
  }
</style>
