---
import Base from '../layouts/Base.astro'
import sitios from '../data/sitios.json'
import resumen from '../data/resumen.json'
import { ETAPAS_CAPACIDAD } from '../lib/capacidad.js'
import UltimosCambios from '../components/UltimosCambios.astro'
import { ESTADO_ETIQUETA, ORDEN_ESTADOS, MODELO_ETIQUETA, numero } from '../lib/etiquetas.js'

const ccaas = [...new Set(sitios.map((s) => s.ubicacion.ccaa).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, 'es'),
)
const operadores = [...new Set(sitios.map((s) => s.operador).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, 'es'),
)
const estadosPresentes = ORDEN_ESTADOS.filter((e) => sitios.some((s) => s.estado === e))
const modelosPresentes = Object.keys(MODELO_ETIQUETA).filter((m) => sitios.some((s) => s.modelo === m))
---

<Base
  titulo="Mapa"
  descripcion="Mapa de centros de datos operativos y proyectados en España, con la red de transporte peninsular de 220 y 400 kV superpuesta."
  sinPie
  pantallaCompleta
>
  <div class="barra-exploracion">
    <label class="buscar-mapa" for="filtro-texto"><span class="solo-lectores">Buscar emplazamientos</span><input id="filtro-texto" type="search" placeholder="Nombre, operador, municipio…" autocomplete="off" /></label>
    <div class="estados-rapidos" aria-label="Filtrar por estado">
      <button type="button" data-grupo-estado="todos" aria-pressed="true">Todos</button>
      <button type="button" data-grupo-estado="operativos" aria-pressed="false">Operativos</button>
      <button type="button" data-grupo-estado="construccion" aria-pressed="false">En construcción</button>
      <button type="button" data-grupo-estado="proyectos" aria-pressed="false">En proyecto</button>
    </div>
    <div class="vistas-mapa"><button id="alternar-panel" type="button" aria-expanded="false" aria-controls="panel-filtros">Lista y filtros</button><a href="/proyectos" id="ver-listado" data-ver-listado>Tabla</a><a class="novedades-movil" href="/actualizaciones">Cambios</a></div>
  </div>
  <div class="disposicion">
    <aside id="panel-filtros" class="panel" aria-label="Resultados y filtros del mapa">
      <div class="panel-cabecera">
        <div><p id="recuento" class="recuento" aria-live="polite">{numero(sitios.length)} emplazamientos</p><p id="fuera-mapa" class="pequeno silencio"></p></div>
        <div class="panel-acciones"><a class="tabla-movil" href="/proyectos" data-ver-listado>Ver tabla</a><button id="limpiar-filtros" type="button">Limpiar</button></div>
      </div>
      <div class="filtros-principales">
        <label><span class="etiqueta-campo">Comunidad</span><select id="filtro-ccaa" data-filtro="ccaa"><option value="">Todas</option>{ccaas.map((c) => <option value={c}>{c}</option>)}</select></label>
        <label><span class="etiqueta-campo">Etapa de la capacidad</span><select id="filtro-etapa">{Object.entries(ETAPAS_CAPACIDAD).map(([valor, etiqueta]) => <option value={valor}>{etiqueta}</option>)}</select></label>
        <label><span class="etiqueta-campo">Tamaño del círculo</span><select id="filtro-metrica"><option value="mw_it">MW IT</option><option value="mw_conexion">MW conexión</option><option value="mw_sin_tipo">MW sin tipificar</option></select></label>
      </div>
      <details id="filtros-avanzados" class="filtros-avanzados">
        <summary>Más filtros y capas <span id="filtros-activos"></span></summary>
        <fieldset class="grupo">
          <legend class="etiqueta-campo">Estado detallado</legend>
          {estadosPresentes.map((e) => <label class={`casilla estado-${e}`}><input type="checkbox" data-estado={e} /><span class="punto"></span><span class="casilla-texto">{ESTADO_ETIQUETA[e]}</span><span class="silencio pequeno">{sitios.filter((s) => s.estado === e).length}</span></label>)}
        </fieldset>
        <div class="grupo"><label class="etiqueta-campo" for="filtro-operador">Operador</label><select id="filtro-operador" data-filtro="operador"><option value="">Todos</option>{operadores.map((o) => <option value={o}>{o}</option>)}</select></div>
        <div class="grupo"><label class="etiqueta-campo" for="filtro-modelo">Modelo</label><select id="filtro-modelo" data-filtro="modelo"><option value="">Todos</option>{modelosPresentes.map((m) => <option value={m}>{MODELO_ETIQUETA[m]}</option>)}</select></div>
        <div class="grupo"><label class="etiqueta-campo" for="filtro-confianza">Confianza</label><select id="filtro-confianza" data-filtro="confianza"><option value="">Cualquiera</option><option value="alta">Alta</option><option value="media">Media</option><option value="baja">Baja</option></select></div>
        <div class="grupo"><label class="etiqueta-campo" for="filtro-minimo">Mínimo de <span id="etiqueta-minimo-metrica">MW IT</span> · <span id="valor-minimo">sin mínimo</span></label><input id="filtro-minimo" type="range" min="0" max="200" step="any" value="0" /><label class="casilla pequeno"><input id="filtro-solo-con-metrica" type="checkbox" />Solo con potencia publicada</label></div>
        <fieldset class="grupo">
          <legend class="etiqueta-campo">Capas eléctricas</legend>
          <label class="casilla"><input type="checkbox" data-capa="lineas" /><span class="casilla-texto">Transporte 220/400 kV</span></label>
          <label class="casilla"><input type="checkbox" data-capa="subestaciones" /><span class="casilla-texto">Subestaciones y nudos · {resumen.nodos_red}</span></label>
          <label class="casilla"><input type="checkbox" data-capa="renovables" /><span class="casilla-texto">Renovables y BESS vinculados · {resumen.activos_renovables}</span></label>
          <label class="casilla"><input type="checkbox" data-capa="centrales" /><span class="casilla-texto">Centrales de generación · {numero(resumen.centrales_generacion)}</span></label>
          <p class="ayuda">Red y centrales de OpenStreetMap. Potencia instalada en {numero(resumen.centrales_con_potencia)} centrales. {resumen.generacion_dia ? `Generación medida del ${resumen.generacion_dia}.` : 'Sin generación medida.'} <a href="/metodologia#capas">Origen de las capas</a>.</p>
        </fieldset>
      </details>
      <details class="lectura-mapa"><summary>Capacidad y leyenda</summary><p id="suma" class="pequeno"></p><p class="ayuda">Círculo hueco: sin dato para la etapa elegida. Atenuado: ubicación municipal. Las etapas no se suman.</p><a class="pequeno" href="/metodologia">Metodología</a></details>
      <ol id="lista-resultados" class="lista"><li class="sin-js"><a href="/proyectos">Ver emplazamientos</a></li></ol>
    </aside>
    <div class="zona-mapa">
      <p id="cargando-mapa" class="cargando-mapa" role="status" hidden>Cargando cartografía…</p>
      <div id="mapa" role="region" aria-label="Mapa interactivo de centros de datos"></div>
      <aside id="panel-detalle" class="detalle-flotante" hidden></aside>
      <details class="novedades-mapa" open><summary>Últimos cambios</summary><UltimosCambios compacto mostrarTitulo={false} /></details>
      <div class="leyenda" aria-label="Leyenda del mapa">
        {estadosPresentes.map((e) => <span class={`leyenda-item estado-${e}`}><span class="punto"></span>{ESTADO_ETIQUETA[e]}</span>)}
        <span id="leyenda-capas" class="leyenda-capas" hidden></span>
      </div>
    </div>
  </div>
</Base>

<script>
  import { iniciarMapa } from '../scripts/mapa.js'
  iniciarMapa()
</script>

<style>
  .disposicion {
    position: relative;
    display: grid;
    grid-template-columns: 22rem 1fr;
    /* La fila no puede crecer con su contenido: si crece, scrollea la página
       entera y el panel de detalle se va fuera de la ventana. */
    grid-template-rows: minmax(0, 1fr);
    flex: 1 1 auto;
    min-height: 0;
  }

  .panel {
    border-right: 1px solid var(--borde);
    min-height: 0;
    overflow-y: auto;
    padding: 0 0 2rem;
    background: var(--papel);
  }

  .panel-cabecera {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--borde);
    position: sticky;
    top: 0;
    background: var(--papel);
    z-index: 2;
  }

  .recuento {
    font-family: var(--serif);
    font-size: 1.05rem;
    margin: 0;
  }

  .panel-cabecera p + p {
    margin: 0.15rem 0 0;
  }

  .panel-acciones { display: flex; align-items: center; gap: .8rem; }
  .tabla-movil { display: none; font-size: .74rem; white-space: nowrap; }

  .grupo {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--borde);
    margin: 0;
    border-left: 0;
    border-right: 0;
    border-top: 0;
  }

  fieldset.grupo {
    border-style: solid none;
  }

  .etiqueta-campo {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tinta-3);
    margin-bottom: 0.4rem;
    padding: 0;
  }

  .grupo > select,
  .grupo > input[type='search'],
  .grupo > input[type='range'] {
    width: 100%;
  }

  .pie-panel {
    padding: 0.85rem 1rem 0;
    border-bottom: 1px solid var(--borde);
    padding-bottom: 0.85rem;
  }

  .ayuda {
    font-size: 0.78rem;
    color: var(--tinta-3);
    margin: 0.45rem 0 0;
    line-height: 1.45;
  }

  .casilla {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.18rem 0;
    font-size: 0.87rem;
    cursor: pointer;
  }

  .casilla-texto {
    flex: 1;
    color: var(--tinta);
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lista :global(.fila-sitio) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--borde);
    border-radius: 0;
    padding: 0.55rem 1rem;
  }

  .lista :global(.fila-punto) {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex: none;
  }

  .lista :global(.fila-texto) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  .lista :global(.fila-texto strong) {
    font-weight: 500;
    font-size: 0.88rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lista :global(.fila-mw) {
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    color: var(--tinta-2);
    white-space: nowrap;
  }

  .lista :global(.fila-mw small) {
    color: var(--tinta-3);
    font-size: 0.72rem;
  }

  .cargando-mapa { position: absolute; z-index: 2; left: 50%; top: 45%; transform: translate(-50%, -50%); padding: .55rem 1rem; background: var(--papel); border: 1px solid var(--borde); font-size: .85rem; }
  .cargando-mapa[hidden] { display: none; }

  .zona-mapa {
    position: relative;
    min-height: 0;
  }

  #mapa {
    position: absolute;
    inset: 0;
  }

  #alternar-panel {
    display: none;
  }

  .leyenda {
    position: absolute;
    left: 0.75rem;
    bottom: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.7rem;
    max-width: 26rem;
    padding: 0.5rem 0.7rem;
    background: color-mix(in srgb, var(--papel) 92%, transparent);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    font-size: 0.75rem;
    backdrop-filter: blur(3px);
  }

  /* Las entradas de las capas se inyectan con innerHTML desde el mapa y no
     reciben el atributo de ámbito de Astro, así que la regla tiene que salir
     del ámbito. Sin esto el contenedor no llega a ser inline-flex, sus hijos
     no son elementos flex y las muestras de color se quedan sin anchura: la
     leyenda enseñaba los rótulos y ninguna marca. */
  .leyenda :global(.leyenda-item) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .leyenda-capas {
    display: flex;
    flex-basis: 100%;
    flex-wrap: wrap;
    gap: 0.15rem 0.7rem;
    padding-top: 0.35rem;
    margin-top: 0.15rem;
    border-top: 1px solid var(--borde);
    color: var(--tinta-2);
  }

  .leyenda :global(.trazo) {
    flex: none;
    width: 1.1rem;
    height: 2px;
    border-radius: 1px;
  }

  .leyenda :global(.trazo-400) {
    background: #b3543f;
  }

  .leyenda :global(.trazo-220) {
    background: #7d8fa3;
  }

  .leyenda :global(.cuadro) {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border: 1px solid #7a6a4a;
  }

  .leyenda :global(.punto-central) {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .leyenda :global(.punto-renovable) {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #a797f9;
  }

  .detalle-flotante {
    position: absolute;
    top: 0.75rem;
    right: 3.4rem;
    width: min(22rem, calc(100% - 5rem));
    max-height: calc(100% - 4rem);
    overflow-y: auto;
    background: var(--papel);
    border: 1px solid var(--borde-fuerte);
    border-radius: var(--radio);
    padding: 1rem 1.1rem 1.1rem;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.13);
  }

  .detalle-flotante :global(h2) {
    font-size: 1.1rem;
    margin: 0.5rem 0 0.75rem;
  }

  .detalle-flotante :global(.cerrar) {
    float: right;
    border: 0;
    background: none;
    font-size: 1.3rem;
    line-height: 1;
    padding: 0 0.2rem;
    color: var(--tinta-3);
  }

  .detalle-flotante :global(.detalle) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.8rem;
    margin: 0 0 0.9rem;
    font-size: 0.87rem;
  }

  .detalle-flotante :global(.detalle dt) {
    color: var(--tinta-3);
  }

  .detalle-flotante :global(.detalle dd) {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .detalle-flotante :global(.boton-ficha) {
    display: inline-block;
    font-size: 0.87rem;
  }

  .detalle-flotante :global(.tabla-mini) {
    overflow-x: auto;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    margin: 0.5rem 0;
  }

  .detalle-flotante :global(.tabla-mini table) {
    font-size: 0.78rem;
  }

  .detalle-flotante :global(.tabla-mini th),
  .detalle-flotante :global(.tabla-mini td) {
    padding: 0.3rem 0.45rem;
  }

  /* Aviso sobre el lienzo: un mapa que falla en silencio es indistinguible de
     un mapa vacío, así que cuando falla lo dice y explica qué sigue sirviendo. */
  .zona-mapa :global(.aviso-mapa) {
    position: absolute;
    z-index: 15;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(30rem, calc(100% - 2rem));
    padding: 0.8rem 2.2rem 0.85rem 0.95rem;
    background: var(--papel);
    border: 1px solid var(--borde-fuerte);
    border-left: 3px solid var(--aviso);
    border-radius: var(--radio);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.16);
    font-size: 0.85rem;
  }

  .zona-mapa :global(.aviso-mapa strong) {
    display: block;
    font-family: var(--serif);
    font-size: 0.98rem;
    margin-bottom: 0.2rem;
  }

  .zona-mapa :global(.aviso-mapa p) {
    margin: 0;
    color: var(--tinta-2);
    line-height: 1.45;
  }

  .zona-mapa :global(.aviso-mapa button) {
    margin-top: 0.6rem;
    font-size: 0.83rem;
  }

  .zona-mapa :global(.aviso-cerrar) {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    margin: 0;
    padding: 0 0.3rem;
    border: 0;
    background: none;
    color: var(--tinta-3);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .zona-mapa :global(.aviso-cerrar:hover) {
    background: none;
    color: var(--tinta);
  }

  /* Los controles de MapLibre vienen con su propio blanco y su propia sombra:
     se los trae a la paleta del sitio, y sus iconos se invierten en oscuro. */
  :global(.maplibregl-ctrl-group) {
    background: var(--papel);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.12);
    overflow: hidden;
  }

  :global(.maplibregl-ctrl-group button) {
    width: 28px;
    height: 28px;
    background: transparent;
    border-radius: 0;
    transition: background-color 0.12s ease;
  }

  :global(.maplibregl-ctrl-group button:hover) {
    background: var(--papel-2);
  }

  :global(.maplibregl-ctrl-group button + button) {
    border-top: 1px solid var(--borde);
  }

  :global(.maplibregl-ctrl-attrib) {
    background: color-mix(in srgb, var(--papel) 88%, transparent);
    color: var(--tinta-3);
    font-size: 0.68rem;
  }

  :global(.maplibregl-ctrl-attrib a) {
    color: var(--tinta-2);
  }

  :global(.maplibregl-ctrl-scale) {
    background: color-mix(in srgb, var(--papel) 80%, transparent);
    border-color: var(--borde-fuerte);
    color: var(--tinta-2);
    font-size: 0.68rem;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-tema='claro']) .maplibregl-ctrl-icon) {
      filter: invert(0.88);
    }
  }

  :global(:root[data-tema='oscuro'] .maplibregl-ctrl-icon) {
    filter: invert(0.88);
  }

  .barra-exploracion { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; padding: .65rem 1rem; border-bottom: 1px solid var(--borde); }
  .buscar-mapa { flex: 1 1 18rem; max-width: 29rem; }
  .buscar-mapa input { width: 100%; }
  .solo-lectores { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .estados-rapidos, .vistas-mapa { display: flex; align-items: center; gap: .35rem; }
  .estados-rapidos button { padding: .35rem .65rem; font-size: .76rem; background: transparent; border-color: transparent; }
  .estados-rapidos [aria-pressed='true'] { background: var(--acento-suave); color: var(--acento); border-color: var(--borde); }
  .vistas-mapa { margin-left: auto; font-size: .8rem; gap: .8rem; }
  .novedades-movil { display: none; }
  .filtros-principales { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; padding: .8rem 1rem; border-bottom: 1px solid var(--borde); }
  .filtros-principales label { min-width: 0; }
  .filtros-principales select { width: 100%; font-size: .78rem; }
  .filtros-principales .etiqueta-campo { font-size: .64rem; }
  .filtros-avanzados { border-bottom: 1px solid var(--borde); }
  .filtros-avanzados > summary, .lectura-mapa > summary { padding: .55rem 1rem; font-size: .79rem; margin: 0 !important; }
  .lectura-mapa { border-bottom: 1px solid var(--borde); }
  .lectura-mapa p, .lectura-mapa > a { margin: 0 1rem .55rem; }
  .panel-cabecera { position: static; padding: .7rem 1rem; }
  .panel-cabecera #fuera-mapa { font-size: .72rem; }
  #limpiar-filtros { font-size: .74rem; }
  .novedades-mapa { position: absolute; z-index: 3; top: .75rem; right: 3.4rem; width: min(20rem, calc(100% - 5rem)); background: color-mix(in srgb, var(--papel) 96%, transparent); padding: 0 .85rem; border: 1px solid var(--borde); box-shadow: 0 2px 6px rgb(0 0 0 / .04); border-radius: var(--radio); }
  .novedades-mapa > summary { font-family: var(--serif); font-weight: 600; font-size: .95rem; margin: 0 !important; }
  .novedades-mapa[open] { padding-bottom: .55rem; }
  .zona-mapa:has(.detalle-flotante:not([hidden])) .novedades-mapa { display: none; }
  .sin-js, .sin-resultados { padding: 1rem; font-size: .85rem; }
  @media (max-width: 1050px) { .estados-rapidos { order: 3; flex-basis: 100%; } }
  @media (max-width: 900px) {
    .barra-exploracion { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .5rem; padding: .55rem .75rem; }
    .buscar-mapa { flex-basis: calc(100% - 7.5rem); min-width: 0; }
    .estados-rapidos { order: 3; grid-column: 1 / -1; overflow-x: auto; flex-wrap: nowrap; }
    .estados-rapidos button { white-space: nowrap; flex: none; }
    .vistas-mapa { gap: .5rem; margin-left: 0; }
    .vistas-mapa #ver-listado { display: none; }
    .tabla-movil { display: inline; }
    .novedades-movil { display: inline; font-size: .72rem; }
    #alternar-panel { display: block; font-size: .72rem; padding: .4rem .5rem; }
    .disposicion { grid-template-columns: 1fr; }
    .panel { position: absolute; z-index: 20; inset: 0; border-right: 0; visibility: hidden; pointer-events: none; transform: translateX(-100%); transition: transform .2s ease; }
    .panel.abierto { transform: none; visibility: visible; pointer-events: auto; }
    .novedades-mapa { display: none; }
    .leyenda { display: none; }
    .detalle-flotante { top: .75rem; right: 3.4rem; width: calc(100% - 4.2rem); }
    .zona-mapa :global(.aviso-mapa) { top: .6rem; }
  }
</style>
