---
import Base from '../layouts/Base.astro'
import Glosa from './Glosa.astro'

const { tesis } = Astro.props
const signo = (valor) => `${valor > 0 ? '+' : ''}${valor.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}%`
const claseRetorno = (valor) => valor > 0 ? 'positivo' : valor < 0 ? 'negativo' : ''
---

<Base titulo={`${tesis.nombre} · Tesis de inversión`} descripcion={tesis.descripcion}>
  <article class="informe-inversion">
    <header class="portada">
      <div class="pagina">
        <p class="migas"><a href="/inversion">Tesis de inversión</a> · {tesis.nombre}</p>
        <div class="portada-grid">
          <div class="portada-texto">
            <div class="portada-meta">
              <span class="ticker">{tesis.ticker}</span>
              <span>{tesis.categoria}</span>
              <span>Análisis del {tesis.fecha}</span>
            </div>
            <h1>{tesis.nombre}</h1>
          </div>
          <aside class="veredicto" aria-label="Conclusión de inversión">
            <p class="veredicto-cabecera">
              <span>Lectura</span>
              <strong>{tesis.lectura}</strong>
            </p>
            <p class="veredicto-texto"><Glosa texto={tesis.veredicto} /></p>
          </aside>
        </div>
      </div>
    </header>

    <nav class="indice" aria-label="Índice del informe">
      <div class="pagina">
        <a href="#informe-completo">Tesis completa</a>
        <a href="#cotizacion">Cotización</a>
        <a href="#exposicion">Exposición</a>
        <a href="#cuentas">Resultados y balance</a>
        <a href="#valoracion">Valoración</a>
        <a href="#escenarios">Escenarios</a>
        <a href="#seguimiento">Seguimiento</a>
        <a href="#fuentes">Fuentes y limitaciones</a>
      </div>
    </nav>

    <div class="pagina cuerpo">
      <section class="panel-metricas" aria-label="Indicadores principales">
        {tesis.metricas.map((metrica) => (
          <div class="metrica">
            <span><Glosa texto={metrica.etiqueta} /></span>
            <strong>{metrica.valor}</strong>
            <small><Glosa texto={metrica.nota} /></small>
          </div>
        ))}
      </section>

      <p class="corte-datos">
        Fotografía de mercado al cierre del {tesis.mercado.fechaLarga}. Las cuentas conservan sus fechas de corte.
      </p>

      <section class="claves-resumen" aria-label="Supuestos y riesgos principales">
        <div>
          <h2>Qué sostiene la tesis</h2>
          <ul>{tesis.favor.slice(0, 2).map((punto) => <li><Glosa texto={punto} /></li>)}</ul>
        </div>
        <div>
          <h2>Riesgos principales</h2>
          <ul>{tesis.contra.slice(0, 2).map((punto) => <li><Glosa texto={punto} /></li>)}</ul>
        </div>
      </section>

      <details class="informe-completo" id="informe-completo">
        <summary>Leer la tesis completa <span>Valoración, escenarios, seguimiento y fuentes</span></summary>
        <div class="marco-tesis">
            <p class="titular"><Glosa texto={tesis.sobrelinea} /></p>
            <p class="tesis-corta"><Glosa texto={tesis.tesisCorta} /></p>
            <dl>
              <div><dt>Precio de referencia</dt><dd>{tesis.mercado.precio}</dd></div>
              <div><dt>Fecha de cierre</dt><dd>{tesis.mercado.fecha}</dd></div>
              <div><dt>Horizonte de inversión</dt><dd>{tesis.horizonte}</dd></div>
            </dl>
      <p class="corte-datos">
        Precio al cierre del {tesis.mercado.fechaLarga}. Cada tabla indica la fecha de corte de los
        datos financieros. La rentabilidad bursátil no incluye dividendos. Este documento es un análisis
        y no asesoramiento financiero.
      </p>
        </div>


        <section id="tesis" class="seccion">
          <div class="titulo-lateral"><span>01</span><h2>Resumen de la tesis</h2></div>
          <div class="contenido">
            <p class="entradilla"><Glosa texto={tesis.resumen} /></p>
            <div class="tesis-grid">
              <div class="caso favor">
                <p class="caso-titulo">Qué debe cumplirse</p>
                <ul>{tesis.favor.map((punto) => <li><Glosa texto={punto} /></li>)}</ul>
              </div>
              <div class="caso contra">
                <p class="caso-titulo">Riesgos para la tesis</p>
                <ul>{tesis.contra.map((punto) => <li><Glosa texto={punto} /></li>)}</ul>
              </div>
            </div>
            <div class="lectura-clave"><span>Mi lectura</span><p><Glosa texto={tesis.miLectura} /></p></div>
          </div>
        </section>

        <section id="cotizacion" class="seccion">
          <div class="titulo-lateral"><span>02</span><h2>Evolución bursátil reciente</h2></div>
          <div class="contenido">
            <p>{tesis.mercado.comentario}</p>
            <div class="tabla-envoltorio">
              <table class="rendimientos">
                <thead><tr><th>Activo</th><th>Rentabilidad desde {tesis.mercado.inicioYtd}</th><th>Rentabilidad desde {tesis.mercado.inicioUnAno}</th><th>Precio de cierre</th></tr></thead>
                <tbody>
                  <tr>
                    <td><strong>{tesis.nombre}</strong></td>
                    <td class={claseRetorno(tesis.mercado.ytd)}>{signo(tesis.mercado.ytd)}</td>
                    <td class={claseRetorno(tesis.mercado.unAno)}>{signo(tesis.mercado.unAno)}</td>
                    <td>{tesis.mercado.precio}</td>
                  </tr>
                  <tr>
                    <td>IBEX 35</td>
                    <td class={claseRetorno(tesis.mercado.ibexYtd)}>{signo(tesis.mercado.ibexYtd)}</td>
                    <td class={claseRetorno(tesis.mercado.ibexUnAno)}>{signo(tesis.mercado.ibexUnAno)}</td>
                    <td>{tesis.mercado.ibexCierre}</td>
                  </tr>
                  <tr class="diferencial">
                    <td>Diferencia frente al IBEX 35</td>
                    <td>{signo(tesis.mercado.ytd - tesis.mercado.ibexYtd)} p.p.</td>
                    <td>{signo(tesis.mercado.unAno - tesis.mercado.ibexUnAno)} p.p.</td>
                    <td></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="metodo">{tesis.mercado.metodo}</p>
          </div>
        </section>

        <section id="exposicion" class="seccion">
          <div class="titulo-lateral"><span>03</span><h2>Relación con los centros de datos</h2></div>
          <div class="contenido">
            <p class="entradilla"><Glosa texto={tesis.exposicion.intro} /></p>
            <div class="cadena">
              {tesis.exposicion.cadena.map((paso, indice) => (
                <div><span>{String(indice + 1).padStart(2, '0')}</span><strong>{paso.titulo}</strong><p><Glosa texto={paso.texto} /></p></div>
              ))}
            </div>
            {tesis.exposicion.proyectos?.length > 0 && (
              <div class="tabla-envoltorio">
                <table>
                  <thead><tr><th>Activo o vínculo</th><th>Estado</th><th>Implicación para el accionista</th></tr></thead>
                  <tbody>{tesis.exposicion.proyectos.map((proyecto) => (
                    <tr>
                      <td>{proyecto.href ? <a href={proyecto.href}>{proyecto.nombre}</a> : proyecto.nombre}</td>
                      <td>{proyecto.estado}</td>
                      <td><Glosa texto={proyecto.lectura} /></td>
                    </tr>
                  ))}</tbody>
                </table>
              </div>
            )}
            {tesis.exposicion.nota && <p class="nota-analista"><Glosa texto={tesis.exposicion.nota} /></p>}
          </div>
        </section>

        <section id="cuentas" class="seccion">
          <div class="titulo-lateral"><span>04</span><h2>Resultados y balance</h2></div>
          <div class="contenido">
            <p>{tesis.finanzas.intro}</p>
            <div class="bloques-cuentas">
              {tesis.finanzas.bloques.map((bloque) => (
                <div>
                  <h3>{bloque.titulo}</h3>
                  <dl>{bloque.filas.map((fila) => <div><dt><Glosa texto={fila[0]} /></dt><dd>{fila[1]}</dd></div>)}</dl>
                </div>
              ))}
            </div>
            <p class="nota-analista"><Glosa texto={tesis.finanzas.nota} /></p>
          </div>
        </section>

        <section id="valoracion" class="seccion">
          <div class="titulo-lateral"><span>05</span><h2>Valoración y materialidad</h2></div>
          <div class="contenido">
            <p class="entradilla"><Glosa texto={tesis.valoracion.intro} /></p>
            <div class="valoracion-grid">
              {tesis.valoracion.bloques.map((bloque) => (
                <div><span><Glosa texto={bloque.etiqueta} /></span><strong>{bloque.valor}</strong><p><Glosa texto={bloque.texto} /></p></div>
              ))}
            </div>
            <p class="nota-analista"><Glosa texto={tesis.valoracion.nota} /></p>
          </div>
        </section>

        <section id="escenarios" class="seccion">
            <div class="titulo-lateral"><span>06</span><h2>Escenarios y supuestos</h2></div>
          <div class="contenido">
            <div class="escenarios">
              {tesis.escenarios.map((escenario) => (
                <div><span>{escenario.nombre}</span><h3>{escenario.titulo}</h3><p><Glosa texto={escenario.texto} /></p></div>
              ))}
            </div>
            <p class="metodo">Los escenarios muestran el efecto de los supuestos principales. No sustituyen un modelo financiero completo ni constituyen una estimación puntual de la cotización.</p>
          </div>
        </section>

        <section id="seguimiento" class="seccion">
          <div class="titulo-lateral"><span>07</span><h2>Indicadores de seguimiento</h2></div>
          <div class="contenido">
            <div class="tabla-envoltorio">
              <table>
                <thead><tr><th>Indicador</th><th>Qué confirmaría la tesis</th><th>Señal de riesgo</th></tr></thead>
                <tbody>{tesis.seguimiento.map((fila) => (
                  <tr><td><strong><Glosa texto={fila.indicador} /></strong></td><td><Glosa texto={fila.confirma} /></td><td><Glosa texto={fila.alarma} /></td></tr>
                ))}</tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="fuentes" class="seccion fuentes">
          <div class="titulo-lateral"><span>08</span><h2>Fuentes y limitaciones</h2></div>
          <div class="contenido">
            <ol>{tesis.fuentes.map((fuente) => <li><a href={fuente.url} rel="noopener">{fuente.titulo}</a><span>{fuente.nota}</span></li>)}</ol>
            <p><Glosa texto={tesis.limites} /></p>
          </div>
        </section>
      </details>
    </div>
  </article>
</Base>

<style>
  .claves-resumen { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 2rem; margin: 1.3rem 0; }
  .claves-resumen h2 { font: 600 .85rem var(--sans); margin: 0 0 .4rem; }
  .claves-resumen ul { margin: 0; padding-left: 1.1rem; color: var(--tinta-2); font-size: .82rem; }
  .claves-resumen li + li { margin-top: .35rem; }
  .informe-completo { margin: 1.5rem 0 3rem; border-top: 1px solid var(--borde-fuerte); scroll-margin-top: calc(var(--alto-cabecera, 3.1rem) + 3.5rem); }
  .informe-completo > summary { padding: 1rem 0; font-size: .95rem; font-weight: 600; color: var(--acento); cursor: pointer; }
  .informe-completo > summary span { display: block; font-size: .75rem; color: var(--tinta-3); font-weight: 400; margin-top: .2rem; }
  .marco-tesis { max-width: 52rem; padding-top: .5rem; }
  .marco-tesis dl { display: flex; flex-wrap: wrap; gap: .5rem 2rem; margin: 1rem 0; }
  .marco-tesis dt { color: var(--tinta-3); font-size: .75rem; }
  .marco-tesis dd { margin: 0; font-size: .82rem; }
  @media (max-width: 620px) {
    .claves-resumen { grid-template-columns: 1fr; gap: 1rem; }
    .portada h1 { font-size: 1.9rem; }
    .portada-grid { gap: .8rem; }
    .veredicto { padding: .7rem .85rem; }
  }

  .informe-inversion { --verde: #41684f; --rojo: #854840; }
  .pagina { width: min(var(--ancho), calc(100% - 2.5rem)); margin-inline: auto; }
  .portada { border-bottom: 1px solid var(--borde-fuerte); padding: 1rem 0 1.1rem; background: var(--papel); }
  .migas { color: var(--tinta-3); font-size: .76rem; margin-bottom: 0.8rem; }
  .portada-meta { display: flex; gap: .35rem 1.2rem; flex-wrap: wrap; color: var(--tinta-3); font: .7rem var(--mono); text-transform: uppercase; letter-spacing: .04em; }
  .ticker { color: var(--tinta); }
  .portada-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(16rem, .7fr); gap: 1.6rem 3rem; align-items: start; }
  .portada-texto { max-width: 46rem; }
  h1 { font: 600 clamp(2rem, 1.5rem + 2vw, 3rem)/1.08 var(--serif); letter-spacing: -.02em; margin: .5rem 0 0; }
  .titular { color: var(--tinta-2); font: 1.15rem/1.4 var(--serif); margin: .5rem 0 0; max-width: 44ch; text-wrap: balance; }
  .tesis-corta { color: var(--tinta-2); font-size: .92rem; line-height: 1.6; margin-top: 1.1rem; padding-top: .9rem; border-top: 1px solid var(--borde); }
  .veredicto { border: 1px solid var(--borde); border-top: 3px solid var(--acento); padding: .9rem 1rem 1rem; background: var(--papel-2); align-self: start; }
  .veredicto-cabecera { display: flex; flex-direction: column; gap: .2rem; margin: 0 0 .5rem; }
  .veredicto-cabecera span, .lectura-clave > span { color: var(--tinta-3); font: .66rem var(--mono); text-transform: uppercase; letter-spacing: .06em; }
  .veredicto-cabecera strong { font: 600 1.15rem/1.25 var(--serif); }
  .veredicto-texto { color: var(--tinta-2); font-size: .8rem; line-height: 1.5; margin: 0; }
  .veredicto dl { margin: .85rem 0 0; }
  .veredicto dl div { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-top: 1px solid var(--borde); padding: .35rem 0; font-size: .72rem; }
  .veredicto dt { color: var(--tinta-3); }
  .veredicto dd { margin: 0; text-align: right; font: .74rem var(--mono); color: var(--tinta); }
  .indice { position: sticky; top: var(--alto-cabecera, 3.1rem); z-index: 20; border-bottom: 1px solid var(--borde); background: color-mix(in srgb, var(--papel) 94%, transparent); backdrop-filter: blur(8px); }
  .indice .pagina { display: flex; gap: 1.2rem; overflow-x: auto; padding-block: .55rem; }
  .indice a { color: var(--tinta-3); font-size: .72rem; text-decoration: none; white-space: nowrap; }
  .cuerpo { padding-top: 1rem; }
  .panel-metricas { display: grid; grid-template-columns: repeat(5, 1fr); border: 1px solid var(--borde); background: var(--borde); gap: 1px; }
  .metrica { background: var(--papel); padding: .75rem; }
  .metrica span { display: block; color: var(--tinta-3); font-size: .68rem; text-transform: uppercase; }
  .metrica strong { display: block; font: 600 1.45rem var(--serif); margin: .2rem 0; }
  .metrica small { color: var(--tinta-3); font-size: .67rem; line-height: 1.35; display: block; }
  .corte-datos, .metodo { color: var(--tinta-3); font-size: .7rem; margin-top: .65rem; }
  .seccion { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 2.2rem; border-top: 1px solid var(--borde-fuerte); padding-top: 1.2rem; margin-top: 2rem; scroll-margin-top: calc(var(--alto-cabecera, 3.1rem) + 3.5rem); }
  .titulo-lateral { display: flex; gap: .65rem; align-items: baseline; }
  .titulo-lateral > span { color: var(--tinta-3); font: .7rem var(--mono); }
  .titulo-lateral h2 { margin: 0; font-size: 1.25rem; }
  .contenido { min-width: 0; }
  .entradilla { font: 1.08rem/1.6 var(--serif); max-width: 52rem; }
  .tesis-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--borde); border: 1px solid var(--borde); margin-top: 1.4rem; }
  .caso { background: var(--papel); padding: 1.1rem; }
  .caso-titulo { font: 600 .78rem var(--mono); text-transform: uppercase; }
  .caso ul { margin: 0; padding-left: 1.1rem; color: var(--tinta-2); font-size: .84rem; }
  .caso li + li { margin-top: .45rem; }
  .favor { border-top: 3px solid var(--verde); }
  .contra { border-top: 3px solid var(--rojo); }
  .lectura-clave { margin-top: 1.2rem; padding: 1rem 1.1rem; border-left: 3px solid var(--acento); background: var(--papel-2); }
  .lectura-clave p { margin: .35rem 0 0; font-family: var(--serif); }
  .tabla-envoltorio { overflow-x: auto; margin-top: 1rem; }
  table { width: 100%; border-collapse: collapse; min-width: 42rem; }
  th { color: var(--tinta-3); font-size: .66rem; font-weight: 500; text-align: left; text-transform: uppercase; letter-spacing: .04em; }
  th, td { border-bottom: 1px solid var(--borde); padding: .55rem .7rem; vertical-align: top; }
  td { font-size: .78rem; }
  .rendimientos td:not(:first-child) { font: 600 .9rem var(--mono); }
  .positivo { color: var(--verde); }
  .negativo { color: var(--rojo); }
  .diferencial { background: var(--papel-2); }
  .cadena { display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid var(--borde); margin: 1.2rem 0; }
  .cadena > div { padding: 1rem; border-right: 1px solid var(--borde); border-bottom: 1px solid var(--borde); }
  .cadena span { color: var(--tinta-3); font: .68rem var(--mono); }
  .cadena strong { display: block; margin: .25rem 0; font-family: var(--serif); }
  .cadena p { color: var(--tinta-2); font-size: .8rem; margin: 0; }
  .nota-analista { border-left: 2px solid var(--borde-fuerte); padding-left: .9rem; color: var(--tinta-2); font-size: .8rem; margin-top: 1.2rem; }
  .bloques-cuentas, .valoracion-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.2rem; }
  .bloques-cuentas > div, .valoracion-grid > div { border: 1px solid var(--borde); padding: 1rem; }
  .bloques-cuentas h3 { margin: 0 0 .7rem; }
  .bloques-cuentas dl { margin: 0; }
  .bloques-cuentas dl div { display: flex; justify-content: space-between; gap: 1rem; padding: .4rem 0; border-top: 1px solid var(--borde); font-size: .78rem; }
  .bloques-cuentas dd { margin: 0; text-align: right; font-weight: 600; }
  .valoracion-grid span { color: var(--tinta-3); font: .68rem var(--mono); text-transform: uppercase; }
  .valoracion-grid strong { display: block; font: 600 1.55rem var(--serif); margin: .2rem 0; }
  .valoracion-grid p { color: var(--tinta-2); font-size: .8rem; margin: 0; }
  .escenarios { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--borde); border: 1px solid var(--borde); }
  .escenarios > div { background: var(--papel); padding: 1rem; }
  .escenarios span { color: var(--tinta-3); font: .68rem var(--mono); text-transform: uppercase; }
  .escenarios h3 { margin: .35rem 0; }
  .escenarios p { color: var(--tinta-2); font-size: .78rem; }
  .fuentes ol { padding-left: 1.2rem; }
  .fuentes li { padding: .4rem 0; font-size: .78rem; }
  .fuentes li span { display: block; color: var(--tinta-3); }
  .fuentes .contenido > p { color: var(--tinta-3); font-size: .74rem; }
  @media (max-width: 900px) {
    .portada-grid, .seccion { grid-template-columns: 1fr; gap: 1.3rem; }
    .veredicto { max-width: 34rem; }
    .panel-metricas { grid-template-columns: repeat(2, 1fr); }
    .indice { top: var(--alto-cabecera, 0px); }
    .titulo-lateral { border-bottom: 1px solid var(--borde); padding-bottom: .5rem; }
  }
  @media (max-width: 620px) {
    .veredicto { max-width: none; }
    .tesis-grid, .cadena, .bloques-cuentas, .valoracion-grid, .escenarios { grid-template-columns: 1fr; }
    .panel-metricas { grid-template-columns: 1fr 1fr; }
    .panel-metricas .metrica:last-child { grid-column: 1 / -1; }
  }
</style>
