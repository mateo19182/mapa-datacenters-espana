---
import '../styles/global.css'
import resumen from '../data/resumen.json'
import { REPOSITORIO } from '../lib/enlaces.js'

// `pantallaCompleta` es para la vista de mapa: ocupa exactamente la ventana y
// el scroll ocurre dentro del panel, no en la página.
const { titulo, descripcion, sinPie = false, pantallaCompleta = false } = Astro.props
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/'
const activo = (href) => (ruta === href || (href !== '/' && ruta.startsWith(href)) ? 'page' : undefined)

const grupos = [
  { titulo: 'Explorar', enlaces: [['/proyectos', 'Emplazamientos'], ['/computo', 'Cómputo y GPU'], ['/guias/clusters-ia', 'Carrera de clústeres de IA'], ['/companias', 'Operadores'], ['/regiones', 'Comunidades']] },
  { titulo: 'Energía', enlaces: [['/red-electrica', 'Red eléctrica'], ['/renovables', 'Renovables y almacenamiento'], ['/guias/red-electrica', 'Guía de acceso a la red'], ['/guias/renovables', 'Guía de contratos y energía']] },
]
const referencias = [
  ['/actualizaciones', 'Últimos cambios'],
  ['/revision', 'Pendientes de revisión'],
  ['/cobertura', 'Cobertura del registro'],
  ['/incertidumbres', 'Incertidumbres'],
  ['/fuentes', 'Fuentes'],
  ['/glosario', 'Glosario'],
  ['/metodologia', 'Metodología'],
]

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo ? `${titulo} · Centros de datos en España` : 'Centros de datos en España'}</title>
    <meta name="description" content={descripcion ?? 'Registro documental de centros de datos en España y su relación con la red eléctrica de transporte.'} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={titulo ?? 'Centros de datos en España'} />
    <meta property="og:description" content={descripcion ?? 'Registro documental de centros de datos en España y su relación con la red eléctrica.'} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Últimos cambios · Centros de datos en España" href="/actualizaciones.xml" />
  </head>
  <body class:list={[pantallaCompleta && 'pantalla-completa']}>
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="cabecera-fila">
        <a class="marca" href="/">Centros de datos en España</a>
        <button id="abrir-menu" class="boton-menu" type="button" aria-expanded="false" aria-controls="menu">
          Secciones
        </button>
        <nav id="menu" class="nav" aria-label="Navegación principal">
          <a href="/" aria-current={activo('/')}>Mapa</a>
          {grupos.map((grupo) => (
            <details class="nav-grupo" data-activo={grupo.enlaces.some(([href]) => activo(href)) || undefined}>
              <summary>{grupo.titulo}</summary>
              <div class="nav-desplegable">
                {grupo.enlaces.map(([href, texto]) => <a href={href} aria-current={activo(href)}>{texto}</a>)}
              </div>
            </details>
          ))}
          <a href="/normativa" aria-current={activo('/normativa')}>Normativa</a>
          <a href="/inversion" aria-current={activo('/inversion')}>Inversión</a>
          <details class="nav-grupo" data-activo={referencias.some(([href]) => activo(href)) || undefined}>
            <summary>Sobre los datos</summary>
            <div class="nav-desplegable">
              {referencias.map(([href, texto]) => <a href={href} aria-current={activo(href)}>{texto}</a>)}
              <a href={REPOSITORIO} class="nav-externo" rel="noopener">GitHub</a>
            </div>
          </details>
          <a class="nav-datos" href="/datos" aria-current={activo('/datos')}>Descargar datos</a>
        </nav>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <script>
      import { iniciarNavegacion } from '../scripts/navegacion.js'
      iniciarNavegacion()
    </script>

    {!sinPie && (
      <footer class="pie">
        <div class="contenedor">
          <p>{resumen.total_emplazamientos} emplazamientos · {resumen.fuentes_distintas} fuentes · Edición del {resumen.generado}.</p>
          <p class="pie-enlaces">
            <a href="/actualizaciones">Últimos cambios</a>
            <a href="/metodologia">Metodología</a>
            <a href="/cobertura">Cobertura</a>
            <a href="/datos">Datos abiertos</a>
            <a href={REPOSITORIO} rel="noopener">GitHub</a>
          </p>
          <p>
            Cartografía © <a href="https://www.openstreetmap.org/copyright" rel="noopener">colaboradores de OpenStreetMap</a> y ©
            <a href="https://carto.com/attributions" rel="noopener">CARTO</a>.
            <a href="/metodologia#capas">Origen y licencia de las capas</a>.
          </p>
        </div>
      </footer>
    )}
  </body>
</html>
