---
import '../styles/global.css'
import resumen from '../data/resumen.json'
import { REPOSITORIO } from '../lib/enlaces.js'

// `pantallaCompleta` es para la vista de mapa: ocupa exactamente la ventana y
// el scroll ocurre dentro del panel, no en la página.
const { titulo, descripcion, sinPie = false, pantallaCompleta = false } = Astro.props
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/'
const activo = (href) => (ruta === href || (href !== '/' && ruta.startsWith(href)) ? 'page' : undefined)

// El registro y, aparte, su aparato crítico: cómo está hecho y qué no cubre.
const enlaces = [
  ['/', 'Mapa'],
  ['/proyectos', 'Proyectos'],
  ['/companias', 'Compañías'],
  ['/regiones', 'Regiones'],
  ['/red-electrica', 'Red eléctrica'],
  ['/renovables', 'Renovables'],
  ['/normativa', 'Normativa'],
  ['/inversion', 'Inversión'],
]
const enlacesCriticos = [
  ['/glosario', 'Glosario'],
  ['/incertidumbres', 'Incertidumbres'],
  ['/cobertura', 'Cobertura'],
  ['/fuentes', 'Fuentes'],
  ['/metodologia', 'Metodología'],
  ['/datos', 'Datos'],
]
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo ? `${titulo} · Centros de datos en España` : 'Centros de datos en España'}</title>
    <meta name="description" content={descripcion ?? 'Registro documental de centros de datos en España peninsular y su relación con la red eléctrica de transporte.'} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={titulo ?? 'Centros de datos en España'} />
    <meta property="og:description" content={descripcion ?? 'Registro documental de centros de datos en España peninsular y su relación con la red eléctrica.'} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={[pantallaCompleta && 'pantalla-completa']}>
    <header class="cabecera">
      <div class="cabecera-fila">
        <a class="marca" href="/">Centros de datos en España</a>
        <button id="abrir-menu" class="boton-menu" type="button" aria-expanded="false" aria-controls="menu">
          Secciones
        </button>
        <nav id="menu" class="nav">
          {enlaces.map(([href, texto]) => <a href={href} aria-current={activo(href)}>{texto}</a>)}
          <span class="nav-separador" aria-hidden="true"></span>
          {enlacesCriticos.map(([href, texto]) => (
            <a class="nav-critico" href={href} aria-current={activo(href)}>{texto}</a>
          ))}
          <span class="nav-separador" aria-hidden="true"></span>
          <a class="nav-externo" href={REPOSITORIO} rel="noopener" title="Código, datos de origen e historial de cambios">
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      // El menú se pliega en pantallas estrechas. Sin JS la navegación sigue
      // siendo visible, porque el CSS solo la oculta cuando hay botón.
      const boton = document.getElementById('abrir-menu')
      const menu = document.getElementById('menu')
      document.body.classList.add('con-menu-plegable')
      boton?.addEventListener('click', () => {
        const abierto = menu.classList.toggle('abierto')
        boton.setAttribute('aria-expanded', String(abierto))
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.classList.contains('abierto')) {
          menu.classList.remove('abierto')
          boton.setAttribute('aria-expanded', 'false')
          boton.focus()
        }
      })
    </script>

    {!sinPie && (
      <footer class="pie">
        <div class="contenedor">
          <p>
            Centros de datos en España peninsular y la red de transporte que los alimenta. Cada
            dato lleva su fuente.
          </p>
          <p>
            {resumen.total_emplazamientos} emplazamientos y {resumen.fuentes_distintas} fuentes.
            Conjunto generado el {resumen.generado}.
            <a href="/metodologia">Metodología</a> · <a href="/datos">datos abiertos</a> ·
            <a href={REPOSITORIO} rel="noopener">código y datos en GitHub</a>.
          </p>
          <p>
            Cartografía base © <a href="https://www.openstreetmap.org/copyright" rel="noopener">colaboradores de OpenStreetMap</a> y ©
            <a href="https://carto.com/attributions" rel="noopener">CARTO</a>. Trazado de la red derivado de
            OpenStreetMap (ODbL); no es cartografía oficial de Red Eléctrica.
          </p>
        </div>
      </footer>
    )}
  </body>
</html>
